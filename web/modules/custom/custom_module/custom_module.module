/**
 * Implements hook_link_alter().
 */

function custom_module_link_alter(&$variables)
{
  $current_user = \Drupal::currentUser();
  $user_id = $current_user->id();
  if ($current_user->hasRole('chiropractor_active_')) {
    if (isset($variables['url'])) {
      $url = $variables['url']->toString();
      if (strpos($url, 'payment-methods') !== false && strpos($url, 'delete') !== false) {
        $parsed_url = parse_url($url);
        $query = [];
        if (isset($parsed_url['query'])) {
          parse_str($parsed_url['query'], $query);
        }
        if (isset($query['destination']) && strpos($query['destination'], 'payment-methods') !== false) {
          if (isset($variables['options']['attributes']['class'])) {
            $variables['options']['attributes']['class'] = array_diff($variables['options']['attributes']['class'], ['use-ajax']);
          }
          unset($variables['options']['attributes']['data-dialog-type']);
          unset($variables['options']['attributes']['data-dialog-options']);
          unset($variables['options']['attributes']['data-once']);
        }
      }

    }
  }

}



function PurchasedEntity()
{
  $subscription_storage = \Drupal::entityTypeManager()->getStorage('commerce_subscription');
  $query = $subscription_storage->getQuery();
  $query
    ->condition('uid', \Drupal::currentUser()->id())
    ->condition('state', 'active')
    ->accessCheck(FALSE);
  $subscription_ids = $query->execute();
  if (!empty($subscription_ids)) {
    $subscription_id = reset($subscription_ids);
    $subscription = $subscription_storage->load($subscription_id);
    if ($subscription) {
      $purchased_product = $subscription->get("purchased_entity")->getValue()[0]["target_id"];
      if ($purchased_product == 3 || $purchased_product == 4) {
        return TRUE;
      } else {
        return FALSE;
      }
    }
  }
}

function GlobalPurchasedEntity()
{
  $subscription_storage = \Drupal::entityTypeManager()->getStorage('commerce_subscription');
  $query = $subscription_storage->getQuery();
  $query
    ->condition('uid', \Drupal::currentUser()->id())
    ->condition('state', 'active')
    ->accessCheck(FALSE);
  $subscription_ids = $query->execute();
  if (!empty($subscription_ids)) {
    $subscription_id = reset($subscription_ids);
    $subscription = $subscription_storage->load($subscription_id);
    if ($subscription) {
      $purchased_product = $subscription->get("purchased_entity")->getValue()[0]["target_id"];
      return $purchased_product;
    }
  }
}



function createClinicAndClinicLocation($clinic_title, $chiropractor_email, $uid = NULL)
{
  $uid = $uid ?? 1;
  $eck = [
    'entity_type' => 'clinic',
    'type' => 'clinic',
    'title' => $clinic_title,
    'field_clinic_mail' => $chiropractor_email
  ];
  $clinic_entity = \Drupal\eck\Entity\EckEntity::create($eck);
  $clinic_entity->setOwnerId($uid);
  $clinic_entity->save();
  $new_clinic_id = $clinic_entity->id();
  $clinic_location_eck = [
    'entity_type' => 'clinic',
    'type' => 'clinic_location',
    'title' => $clinic_title . " (Location)",
    'field_clinic' => array('target_id' => $new_clinic_id)
  ];
  $clinic_location_entity = \Drupal\eck\Entity\EckEntity::create($clinic_location_eck);
  $clinic_location_entity->setOwnerId($uid);
  $clinic_location_entity->save();
  $new_clinic_location_id = $clinic_location_entity->id();
  return ["new_clinic_id" => $new_clinic_id, "new_clinic_location_id" => $new_clinic_location_id];
}


