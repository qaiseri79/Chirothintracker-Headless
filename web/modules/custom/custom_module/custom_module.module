function sendChiropractorMessage($entity)
{
  $field_patient = $entity->get("field_patient")->getValue()[0]['target_id'];
  $field_message = $entity->get("field_message")->getValue()[0]['value'];
  $owner_id = $entity->get('uid')->getValue()[0]['target_id'];
  $attachment = $entity->get("field_attachments")->getValue();
  $message_value = [
    'value' => $field_message,
    'format' => "basic_html"
  ];
  $message = Message::create([
    'contact_form' => 'message',
    'uid' => $field_patient,
    'field_from' => $owner_id,
    'field_to' => $field_patient,
    'field_message' => $message_value,
    'field_attachments' => !empty($attachment) ? $entity->get('field_attachments')->getValue()[0]['target_id'] : "",
    'field_patient_uid' => $field_patient,
    //'field_timestamp' => $current_time,
  ]);

  $message->save();
  $new_message = Message::load($message->id());
  $flag_service = \Drupal::service('flag');
  $flag = $flag_service->getFlagById('message_status_contact_storage');
  $account = User::load($new_message->get('uid')->getValue()[0]['target_id']);
  $flagging = $flag_service->getFlagging($flag, $new_message, $account);
  if (!$flagging) {
    $flag_service->flag($flag, $new_message, $account);
  }
  // Delete the patient submission
  $chiropractor_message = Message::load($entity->id());
  if (!empty($chiropractor_message)) {
    $chiropractor_message->delete();
  }

  // Send email to the user.
  messageEmail($field_patient);

}


function messageEmail($patient_id)
{
  $patient = User::load($patient_id);
  $clinician = User::load(\Drupal::currentUser()->id());
  $clinician_clinic = $clinician->get("field_clinic")->getValue();
  $clinician_full_name = $clinician->get("field_full_name")->getValue();
  $fullname = $clinician_full_name[0]["value"];
  if ($clinician_clinic) {
    $clinic_id = $clinician_clinic[0]["target_id"];
    $storage = \Drupal::service('entity_type.manager')->getStorage('clinic');
    $clinic_entity = $storage->load($clinic_id);
    if ($clinic_entity) {
      $clinic_title_field = $clinic_entity->get("title")->getValue();
      if ($clinic_title_field) {
        $clinic_title = $clinic_title_field[0]["value"];
      }
    }
  }
  $field_email_optout = $patient->get("field_email_optout")->getValue();
  if ($field_email_optout) {
    $emailoutput = $field_email_optout[0]["value"];
    if ($emailoutput == 0) {
      $host = \Drupal::request()->getSchemeAndHttpHost();
      $mailManager = \Drupal::service('plugin.manager.mail');
      $module = 'custom_module';
      $key = 'message_email';
      $to = $patient->getEmail();
      $params['subject'] = "You have a new message from " . $clinic_title . "";
      $params['message'] = 'You have received a new message from ' . $fullname . ' at ' . $clinic_title . '. Please log in at ' . $host . ' to review your messages.';
      $langcode = \Drupal::currentUser()->getPreferredLangcode();
      $send = true;
      // $result = $mailManager->mail($module, $key, $to, $langcode, $params, NULL, $send);
      // if ($result['result'] !== true) {
      //   $message = 'Your message was not sent to "' . $patient->get("field_full_name")->getValue()[0]["value"] . '"';
      //   \Drupal::logger('custom_module')->error($message);
      // } else {
      //   $message = 'Your message has been sent to "' . $patient->get("field_full_name")->getValue()[0]["value"] . '"';
      //   \Drupal::logger('custom_module')->notice($message);
      // }

    }
  }
}
function DecrementLaserSession($submission_data, $submission_id)
{
  $patient_profile_id = $submission_data->get('field_patient_profile')->getValue()[0]['target_id'];
  $storage = \Drupal::service('entity_type.manager')->getStorage('patient_profile');
  if ($patient_profile_id) {
    $profile_entity = $storage->load($patient_profile_id);
    $session_available = $profile_entity->get('field_sessions_available')->getValue();
    if ($session_available) {
      $session_value = $session_available[0]['value'];
      $new_session_value = (int) $session_value - 1;
      $profile_entity->set('field_sessions_available', $new_session_value);
      $profile_entity->save();

    }
  }

}
