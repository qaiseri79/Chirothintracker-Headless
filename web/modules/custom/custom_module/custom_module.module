function custom_module_webform_submission_insert(WebformSubmission $submission)
{

  if ($submission->getWebform()->id() == 'patient_message') {
    sendPatientMessage($submission);
  }
  if ($submission->getWebform()->id() == 'chiropractor_message') {
    sendChiropractorMessage($submission);
  }
  if ($submission->getWebform()->id() == 'last_seen') {
    UpdateLastSeen($submission->getData(), $submission->id());
  }
  if ($submission->getWebform()->id() == 'log_patient_progress') {
    LogPatientProgress($submission->getData(), $submission->id());
  }
  if ($submission->getWebform()->id() == 'unsubscribe') {
    UnsubscribePatient($submission->getData(), $submission->id());
  }
  if ($submission->getWebform()->id() == 'patient_account') {
    CreateUser($submission->getData(), $submission->id(), $submission->getOwnerId());
    $patient_account_submission = WebformSubmission::load($submission->id());
    if (!empty($patient_account_submission)) {
      $patient_account_submission->delete();
    }
    \Drupal::messenger()->addMessage("You have successfully added a new patient.", "status", TRUE);
  }
  if ($submission->getWebform()->id() == 'patient_enrollment') {
    EnrollPatientAgain($submission->getData(), $submission->id(), $submission->getOwnerId());
    $enroll_patient_submission = WebformSubmission::load($submission->id());
    if (!empty($enroll_patient_submission)) {
      $enroll_patient_submission->delete();
    }
    \Drupal::messenger()->addMessage("You have successfully re-enrolled the patient.", "status", TRUE);
  }

  if ($submission->getWebform()->id() == 'edit_patient_account') {
    UpatePatientData($submission->getData(), $submission->id(), $submission->getOwnerId());
    $edit_patient_account_submission = WebformSubmission::load($submission->id());
    if (!empty($edit_patient_account_submission)) {
      $edit_patient_account_submission->delete();
    }
  }
  if ($submission->getWebform()->id() == 'subscriber_s_chiropractor') {
    createChiropractor($submission->getData(), $submission->id());
    $subscriber_s_chiropractor = WebformSubmission::load($submission->id());
    if (!empty($subscriber_s_chiropractor)) {
      $subscriber_s_chiropractor->delete();
    }
  }
  if ($submission->getWebform()->id() == 'detach') {
    detachChiropractor($submission->getData(), $submission->id());
    $detachChiropractor_submission = WebformSubmission::load($submission->id());
    if (!empty($detachChiropractor_submission)) {
      $detachChiropractor_submission->delete();
    }
  }

}

function detachChiropractor($submission_data, $submission_id)
{
  $detach = $submission_data["are_you_sure_you_wants_to_detach_from_the_primary_subscriber"];
  $uid = \Drupal::currentUser()->id();
  if ($detach == 1) {
    $user = User::load($uid);
    $field_chiropractor_subscribers = $user->get("field_chiropractor_subscribers")->getValue();
    if (!empty($field_chiropractor_subscribers)) {
      $user->addRole('chiropractor_inactive_');
      $user->removeRole('chiropractor_active_');
      $user->set('field_chiropractor_subscribers', []);
      $user->changed->preserve = TRUE;
      $user->save();
    }
  }
}

function createChiropractor($submission_data, $submission_id)
{
  $clinic_location = $submission_data["clinic_location"];
  $chiropractor_full_name = $submission_data["chiropractor_full_name"];
  $chiropractor_email = $submission_data["chiropractor_email"];

  $uid = \Drupal::currentUser()->id();
  $user = \Drupal::service('entity_type.manager')->getStorage('user')->load($uid);
  $clinic_id = $user->field_clinic->target_id;

  $chiropractor_user = User::create();
  $chiropractor_user->setUsername($chiropractor_email);
  $chiropractor_user->setEmail($chiropractor_email);
  $chiropractor_user->set('field_full_name', $chiropractor_full_name);
  $chiropractor_user->addRole('chiropractor_active_');
  $chiropractor_user->addRole('chiropractor_inactive_');
  $chiropractor_user->set('field_clinic', ['target_id' => $clinic_id]);
  $chiropractor_user->set('field_clinic_location', ['target_id' => $clinic_location]);
  $chiropractor_user->set('field_chiropractor_subscribers', ['target_id' => $uid]);
  $chiropractor_user->enforceIsNew();
  $chiropractor_user->activate();
  $chiropractor_user->save();
}


function UpatePatientData($submission_data, $submission_id, $ownerId)
{
  $full_name = $submission_data["full_name"];
  $patient_email_address = $submission_data["patient_email_address"];
  $goal_weight = $submission_data["goal_weight"];
  $disable_daily_email_notifications = $submission_data["disable_daily_email_notifications"];
  $patient_status = $submission_data["patient_status"];
  $program_start_date = $submission_data["program_start_date"];
  $clinic_location = $submission_data["clinic_location"];
  $phone_number = $submission_data["phone_number"];
  $field_patient_id = $submission_data["field_patient_id"];

  $account = User::load($field_patient_id);
  if ($account) {
    $account->setEmail($patient_email_address);
    // $account->set("name",$patient_email_address);
    $account->set("field_full_name", $full_name);
    $account->set('field_goal_weight', $goal_weight);
    $account->set('field_phone_number', $phone_number);
    if ($disable_daily_email_notifications) {
      $account->set('field_email_optout', $disable_daily_email_notifications);
    }
    $account->set('field_chiropractor', array("target_id" => $ownerId));
    $account->set('field_laser_patient_status', array("target_id" => $patient_status));

    if ($program_start_date) {
      $dateTime = new DateTime($program_start_date);
      // $dateTime->add(new DateInterval('P1D'));
      $formattedDate = $dateTime->format('Y-m-d');
      $account->set('field_program_start_date', $formattedDate);
    }

    if ($clinic_location) {
      $account->set('field_clinic_location', array("target_id" => $clinic_location));
    }

    $account->changed->preserve = TRUE;
    $account->save();

    if ($program_start_date) {
      // update user current program date
      $user_current_program_day = new UserCurrentProgramDay;
      $user_current_program_day->userRoles($account->id());
      $user_current_program_day->userProfile($account->id());
      $user_current_program_day->UserClinician($account->id());
      $user_current_program_day->Evaluations($account->id());

    }

  }

}

function ZeroProgramDays($user_id)
{
  $user_submission = Views::getView('user_submissions');
  $user_submission->setDisplay('default');
  $user_submission->setArguments([$user_id]);
  $user_submission->execute();
  $user_submission_result = $user_submission->result;
  if ($user_submission_result) {
    foreach ($user_submission_result as $key => $value) {
      $submission_id = $user_submission_result[$key]->_entity->id();
      $webform_submission = WebformSubmission::load($submission_id);
      $data = $webform_submission->getData();
      // $data['field_weight'] = 164.5;
      $webform_submission->setData($data);
      $webform_submission->save();
    }
  }
}

function EnrollPatientAgain($submission_data, $submission_id, $ownerId)
{
  $new_patient_id = $submission_data["new_patient"];
  $program_start_date = $submission_data["program_start_date"];
  $goal_weight = $submission_data["goal_weight"];
  $disable_daily_email_notifications = $submission_data["disable_daily_email_notifications"];
  $patient_status = $submission_data["patient_status"];

  $new_patient = User::load($new_patient_id);
  $patient_clinic = $new_patient->get("field_clinic")->getValue();
  $current_chiropractor = User::load($ownerId);
  $current_chiropractor_clinic = $current_chiropractor->get("field_clinic")->getValue();
  if ($current_chiropractor_clinic) {
    $current_chiropractor_clinic_id = $current_chiropractor_clinic[0]["target_id"];
  }

  if ($patient_clinic) {
    $patient_clinic_id = $patient_clinic[0]["target_id"];
  }

  if ($current_chiropractor_clinic_id == $patient_clinic_id) {
    $new_patient->addRole('enrolled_patient');
    $new_patient->removeRole('archived_patient');
    $new_patient->set('field_chiropractor', array("target_id" => $ownerId));
    $new_patient->set('field_clinic', array("target_id" => $current_chiropractor_clinic_id));

    if ($program_start_date) {
      $dateTime = new DateTime($program_start_date);
      $formattedDate = $dateTime->format('Y-m-d');
      $new_patient->set('field_program_start_date', $formattedDate);
    }
    $new_patient->set('field_goal_weight', $goal_weight);
    $new_patient->set('field_weight_loss_phase', "phase-1");
    $new_patient->set('field_laser_patient_status', array("target_id" => $patient_status));
    if ($disable_daily_email_notifications) {
      $new_patient->set('field_email_optout', $disable_daily_email_notifications);
    }
    _user_mail_notify("register_admin_created", $new_patient);
    $new_patient->changed->preserve = TRUE;
    $new_patient->save();

    $user_current_program_day = new UserCurrentProgramDay;
    $user_current_program_day->userRoles($new_patient_id);
    $user_current_program_day->userProfile($new_patient_id);
    $user_current_program_day->UserClinician($new_patient_id);
    $user_current_program_day->Evaluations($new_patient_id);
    $user_current_program_day->CalculateGoal($new_patient_id);

  }
}

function CreateUser($submission_data, $submission_id, $ownerId)
{
  $enrollment_limit = new EnrollmentLimit;
  $result = $enrollment_limit->Limit();
  if ($result) {
    if (array_key_exists("enrollment_status", $result)) {
      if ($result["enrollment_status"] == 0) {
        createNewPatient($submission_data, $submission_id, $ownerId);
      } else if ($result["enrollment_status"] == 1) {
        createNewPatient($submission_data, $submission_id, $ownerId);
      }
    }
  }
}


function createNewPatient($submission_data, $submission_id, $ownerId)
{
  $fullname = $submission_data["patient_full_name"];
  $patient_email_address = $submission_data["patient_email_address"];
  $phone_number = $submission_data["phone_number"];
  $program_start_date = $submission_data["program_start_date"];
  $goal_weight = $submission_data["goal_weight"];
  $clinic_location_ = $submission_data["clinic_location_"];
  $patient_status = $submission_data["patient_status"];
  $intake_form_id = $submission_data["intake_form"];
  $disable_daily_email_notifications = $submission_data["disable_daily_email_notifications"];

  $user = User::create();
  $user->setUsername($patient_email_address);
  $user->setEmail($patient_email_address);
  $user->set('field_phone_number', $phone_number);
  //$user->setPassword('password');
  $user->addRole('enrolled_patient'); // E.g: authenticated.
  $user->enforceIsNew();
  $user->activate();
  $user->save();
  $new_user_id = $user->id();
  if ($new_user_id) {
    $new_user = User::load($new_user_id);
    // set program start date from intake form.
    if ($program_start_date) {
      $dateTime = new DateTime($program_start_date);
      $formattedDate = $dateTime->format('Y-m-d');
      $new_user->set('field_program_start_date', $formattedDate);
    } else {
      $currentDate = date('Y-m-d');
      $nextSaturdayTimestamp = strtotime('next Saturday', strtotime($currentDate));
      $nextSaturdayDate = date('Y-m-d', $nextSaturdayTimestamp);
      $new_user->set('field_program_start_date', $nextSaturdayDate);
    }
    // Set Intake Form ID
    if ($intake_form_id) {
      $new_user->set('field_intake_form', $intake_form_id);
      FlagIntakeForm($intake_form_id, $ownerId);
    }
    $new_user->set('field_goal_weight', $goal_weight);
    $new_user->set('field_weight_loss_phase', "phase-1");
    $new_user->set('field_chiropractor', array("target_id" => $ownerId));

    $chiropractor = User::load($ownerId);
    $clinic = $chiropractor->get("field_clinic")->getValue();
    if ($clinic) {
      $clinic_id = $clinic[0]["target_id"];
      $new_user->set('field_clinic', array("target_id" => $clinic_id));
    }
    if ($clinic_location_) {
      $new_user->set('field_clinic_location', array("target_id" => $clinic_location_));
    }
    $new_user->set('field_full_name', $fullname);
    if ($disable_daily_email_notifications) {
      $new_user->set('field_email_optout', $disable_daily_email_notifications);
    }
    if (in_array('chiropractor_mind_set', $chiropractor->getRoles())) {
      $new_user->addRole('patient_mind_set');
    }
    $new_user->set('field_laser_patient_status', array("target_id" => $patient_status));
    $new_user->set('field_locked', false);
    $new_user->changed->preserve = TRUE;
    $new_user->save();
    // current program day 
    $current_program_day = new UserCurrentProgramDay;
    $current_program_day->userRoles($new_user_id);
    $current_program_day->userProfile($new_user_id);
    $current_program_day->UserClinician($new_user_id);
    $current_program_day->Evaluations($new_user_id);
    $current_program_day->CalculateGoal($new_user_id);
    _user_mail_notify("register_admin_created", $new_user);
  }

}

function FlagIntakeForm($intake_submission_id, $user_id)
{
  $intake_submission = Message::load($intake_submission_id);
  if ($intake_submission) {
    $flag_service = \Drupal::service('flag');
    $flag = $flag_service->getFlagById('intake_processed_cs');
    $account = User::load($user_id);
    $flagging = $flag_service->getFlagging($flag, $intake_submission, $account);
    if (!$flagging) {
      $flag_service->flag($flag, $intake_submission, $account);
    }
  }
}


function sendPatientMessage($entity)
{
  $field_chiropractor = $entity->get("field_chiropractor")->getValue()[0]['target_id'];
  $field_message = $entity->get("field_message")->getValue()[0]['value'];
  $owner_id = $entity->get('uid')->getValue()[0]['target_id'];
  $attachment = $entity->get("field_attachments")->getValue();

  $message_value = [
    'value' => $field_message,
    'format' => "basic_html"
  ];
  $message = Message::create([
    'contact_form' => 'message',
    'uid' => $owner_id,
    'field_from' => $owner_id,
    'field_to' => $field_chiropractor,
    'field_message' => $message_value,
    'field_attachments' => !empty($attachment) ? $entity->get('field_attachments')->getValue()[0]['target_id'] : "",
    'field_patient_uid' => $owner_id,
    // 'field_timestamp' => $current_time,
  ]);
  $message->save();
  $new_message = Message::load($message->id());
  $flag_service = \Drupal::service('flag');
  $flag = $flag_service->getFlagById('clinician_message_status_cs');
  $account = User::load($field_chiropractor);
  $flagging = $flag_service->getFlagging($flag, $new_message, $account);
  if (!$flagging) {
    $flag_service->flag($flag, $new_message, $account);
  }

  // Delete the patient submission
  $patient_message = Message::load($entity->id());
  if (!empty($patient_message)) {
    $patient_message->delete();
  }
  sentEmailPatient($field_chiropractor, $owner_id);
}

