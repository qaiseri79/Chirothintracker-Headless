function custom_module_user_logout(AccountInterface $account)
{
  $current_user = \Drupal::currentUser();
  $roles = $account->getRoles();
  if (in_array('chiropractor_inactive_', $roles) || in_array('chiropractor_active_', $roles)) {
    $cart_manager = \Drupal::service('commerce_cart.cart_manager');
    $current_user = \Drupal::currentUser();
    $store_ids = \Drupal::entityTypeManager()->getStorage('commerce_store')->getQuery()->accessCheck(TRUE)->execute();
    if (
      $carts = \Drupal::entityTypeManager()->getStorage('commerce_order')->loadByProperties([
        'cart' => TRUE,
        'uid' => $current_user->id(),
      ])
    ) {
      foreach ($carts as $cart) {
        $cart_manager->emptyCart($cart);
      }
    }
  }
}

