function UnsubscribePatient($submission_data, $submission_id)
{
  $unsubscribe_daily_email = $submission_data["unsubscribe_daily_email"];
  $current_user = \Drupal::currentUser();
  if (in_array('enrolled_patient', $current_user->getRoles())) {
    $user = User::load(\Drupal::currentUser()->id());
    $user->set('field_email_optout', $unsubscribe_daily_email);
    $user->changed->preserve = TRUE;
    $user->save();
  }
}


function LogPatientProgress($submission_data, $submission_id)
{
  $roles = \Drupal::currentUser()->getRoles();
  if (in_array('chiropractor_active_', $roles)) {
    $log_your_progress_message = Message::create([
      'contact_form' => 'tracking_weight',
      'uid' => $submission_data['patient'],
      'created' => strtotime($submission_data['date']),
      'field_grade' => 5,
      'field_date' => $submission_data['date'],
      'field_weight' => $submission_data['today_s_weight'],
      'field_water_intake' => $submission_data['yesterday_s_water_intake'],
      'field_blood_sugar' => $submission_data['morning_blood_sugar'],
      'field_blood_pressure' => $submission_data['blood_pressure'],
      'field_mind_set_work' => $submission_data['mind_set_work'],
      'field_author' => $submission_data['patient'],
    ]);
    $log_your_progress_message->save();
    if ($log_your_progress_message->id()) {
      $log_patient_progross = WebformSubmission::load($submission_id);
      if (!empty($log_patient_progross)) {
        $log_patient_progross->delete();
      }
    }
  }

}

function UpdateLastSeen($submission_data, $submission_id)
{
  $last_seen = $submission_data["last_seen"];
  $patient_id = $submission_data["patient"];
  $user = User::load($patient_id);
  $user->set('field_last_seen', $last_seen);
  $user->changed->preserve = TRUE;
  $user->save();
  // Delete the Last Seen submission
  $last_seen_submission = WebformSubmission::load($submission_id);
  if (!empty($last_seen_submission)) {
    $last_seen_submission->delete();
  }
}



function custom_module_user_login(\Drupal\user\UserInterface $account)
{
  $clinic = $account->get("field_clinic")->getValue();
  if ($clinic) {
    $clinic_id = $clinic[0]["target_id"];
    $storage = \Drupal::service('entity_type.manager')->getStorage('clinic');
    $clinic_entity = $storage->load($clinic_id);
    if ($clinic_entity->hasField('field_ecommerce_enabled') == true) {
      $ecommerce_enabled = $clinic_entity->get('field_ecommerce_enabled')->getValue();
      if ($ecommerce_enabled) {
        $ecommerce_enabled_value = $ecommerce_enabled[0]["value"];
        if ($ecommerce_enabled_value == true) {
          if (in_array('chiropractor_active_', $account->getRoles())) {
            if (!in_array('ecommerce_manager', $account->getRoles())) {
              //$user->removeRole('archived_patient');
              $account->addRole('ecommerce_manager');
              $account->changed->preserve = TRUE;
              $account->save();
            }
          }
        }
      }
    }
  }
}



