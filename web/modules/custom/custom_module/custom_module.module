// [headless_progress]     }
    // Update Red Light profile.
    if ($entity->bundle() == "ultraslim_profile") {
      $AddOrUpdateSession = new AddOrUpdateSession;
      $AddOrUpdateSession->AddorUpdateSession_UltraSlim($entity, $entity->id());
    }
    if ($entity->bundle() == "zerona_profile") {
      $AddOrUpdateSession = new AddOrUpdateSession;
      $AddOrUpdateSession->AddorUpdateSession_zerona($entity);
    }
    if ($entity->bundle() == "lipolight_profile") {
      $AddOrUpdateSession = new AddOrUpdateSession;
      $AddOrUpdateSession->AddorUpdateSession_lipolight($entity, $entity->id());
    }

  }

  if ($entity->getEntityTypeId() == "menu_item" && $entity->bundle() == "menu_item") {
    $account = User::load(\Drupal::currentUser()->id());
    if (in_array('administrator', $account->getRoles()) || in_array('system_manager', $account->getRoles())) {
      EditMenuItem($entity);
    }
  }
  if ($entity->getEntityTypeId() == "commerce_subscription" && $entity->bundle() == "license") {
    $status = $entity->getState()->getId();
    if ($status == "canceled") {
      //deleteLicenses($entity->getOwnerId());
    }
  }
}


function deleteLicenses($ownerId)
{
  $commerce_licenses = Views::getView('commerce_licenses');
  $commerce_licenses->setDisplay('block_1');
  $commerce_licenses->setArguments([$ownerId]);
  $commerce_licenses->execute();
  $commerce_licenses_result = $commerce_licenses->result;
  if ($commerce_licenses_result) {
    foreach ($commerce_licenses_result as $key => $value) {
      $value->_entity->delete();
      \Drupal::logger('custom_module')->notice('License ID @id Deleted by custom module.', [
        '@id' => $value->_entity->id()
      ]);
    }
  }
}


function custom_module_entity_insert(EntityInterface $entity)
{
  if ($entity->getEntityTypeId() == "menu_item" && $entity->bundle() == "menu_item") {
    $account = User::load(\Drupal::currentUser()->id());
    if (in_array('administrator', $account->getRoles()) || in_array('system_manager', $account->getRoles())) {
      EditMenuItem($entity);
    }
  }

  // User entity
  if ($entity->bundle() == "user") {
    if (in_array('chiropractor_active_', $entity->getRoles())) {
      _user_mail_notify("register_no_approval_required", $entity);
    }
  }

  // Clinic entity
  if ($entity->getEntityTypeId() == "clinic" && $entity->bundle() == "clinic") {
    $account_switcher = \Drupal::service('account_switcher');
    $admin_user = User::load(1);
    $account_switcher->switchTo($admin_user);
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');

    // 'recipe' nodes published to clinic id 1
    $query = $node_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'recipe')
      ->condition('field_published_to', 1);
    $nids = $query->execute();

    // 'chirothin_resource' and 'training' created by any admin user
    $admin_uids = \Drupal::entityQuery('user')
      ->accessCheck(FALSE)
      ->condition('roles', 'administrator')
      ->execute();

    if (!empty($admin_uids)) {
      $admin_query = $node_storage->getQuery()
        ->accessCheck(TRUE)
        ->condition('type', ['chirothin_resource', 'training'], 'IN')
        ->condition('uid', $admin_uids, 'IN');
      $admin_nids = $admin_query->execute();

      // Merge both result sets, avoiding duplicates
      $nids = array_unique(array_merge($nids, $admin_nids));
    }

    // Add clinic to Recipe, Training and Resources
    if (!empty($nids)) {
      $nodes = $node_storage->loadMultiple($nids);
      foreach ($nodes as $node) {
        $node->field_published_to[] = ['target_id' => $entity->id()];
        $node->save();
      }
    }
    $account_switcher->switchBack();
  }

  // Contact Message entity
  if ($entity->getEntityTypeId() === 'contact_message') {
// [headless_progress]     if ($entity->bundle() == "tracking_weight") {
// [headless_progress]       //\Drupal::logger('custom_module')->notice('Tracking weight Insert hook called..');
// [headless_progress]       $owner_id = $entity->get('uid')->getValue()[0]['target_id'];
// [headless_progress]       //flag the owner of the submission.
// [headless_progress]       $log_your_progross = new LogYourProgross;
// [headless_progress]       $log_your_progross->MarkasNew($owner_id);
// [headless_progress] 
// [headless_progress]       $field_question = $entity->get('field_question')->getValue();
// [headless_progress]       $date = $entity->get('field_date')->getValue()[0]['value'];
// [headless_progress]       if (!empty($field_question)) {
// [headless_progress]         createEntity($owner_id, $date, $field_question[0]['value']);
// [headless_progress]       }
// [headless_progress]       // Log Your Progress (Inches)
// [headless_progress]       $total = $log_your_progross->CalculateTotalInches($entity);
// [headless_progress]       $entity->set('field_total_measurements', $total);
// [headless_progress] 
// [headless_progress]       $field_archive = $entity->get('field_archive')->getValue();
// [headless_progress]       if ($field_archive[0]['value'] != true) {
// [headless_progress]         $user_entity = User::load($owner_id);
// [headless_progress]         // Log Your Progress (Evaluations)  
// [headless_progress]         $user_current_program_day = new UserCurrentProgramDay;
// [headless_progress]         $user_current_program_day->userRoles($user_entity->id());
// [headless_progress]         $user_current_program_day->userProfile($user_entity->id());
// [headless_progress]         $user_current_program_day->UserClinician($user_entity->id());
// [headless_progress]         $user_current_program_day->Evaluations($user_entity->id());
// [headless_progress]         $user_current_program_day->CalculateGoal($user_entity->id());
// [headless_progress]         // compute program day   
// [headless_progress]         $field_program_day_computed = $entity->get('field_program_day_computed')->getValue();
// [headless_progress]         if (!empty($field_program_day_computed)) {
// [headless_progress]           if ($field_program_day_computed[0]['value'] < 1) {
// [headless_progress]             $entity->set('field_program_day', 0);
// [headless_progress]           } else {
// [headless_progress]             $entity->set('field_program_day', $field_program_day_computed[0]['value']);
// [headless_progress]           }
// [headless_progress]         }
// [headless_progress]         // compute weight loss to date.
// [headless_progress]         $field_weight_loss_computed = $entity->get('field_weight_loss_computed')->getValue();
// [headless_progress]         if (!empty($field_weight_loss_computed)) {
// [headless_progress]           $entity->set('field_weight_loss_to_date', $field_weight_loss_computed[0]['value']);
// [headless_progress]         }

// [headless_progress]       }//end of archive
// [headless_progress]       $entity->save();
// [headless_progress]     }
    if ($entity->bundle() == "ultraslim_profile") {
      $AddOrUpdateSession = new AddOrUpdateSession;
      $AddOrUpdateSession->AddorUpdateSession_UltraSlim($entity, $entity->id());
      DecrementLaserSession($entity, $entity->id());
    }
    if ($entity->bundle() == "zerona_profile") {
      $AddOrUpdateSession = new AddOrUpdateSession;
      // Pass TRUE to indicate this is an insert (should decrement)
      $AddOrUpdateSession->AddorUpdateSession_zerona($entity, TRUE);
    }
    if ($entity->bundle() == "lipolight_profile") {
      $AddOrUpdateSession = new AddOrUpdateSession;
      $AddOrUpdateSession->AddorUpdateSession_lipolight($entity, $entity->id());
      DecrementLaserSession($entity, $entity->id());
    }
    if ($entity->bundle() == 'patient_message') {
      sendPatientMessage($entity);
    }
    if ($entity->bundle() == 'chiropractor_message') {
      sendChiropractorMessage($entity);
    }
  }
}

function createEntity($submittedby, $created, $question)
{
  $user = User::load($submittedby);
  $chiropractor = $user->get("field_chiropractor")->getValue()[0]["target_id"];
  $message_value = [
    'value' => $question,
    'format' => "filtered_html"
  ];
  $patient_message = Message::create([
    'contact_form' => 'patient_message',
    'uid' => $submittedby,
    'field_chiropractor' => $chiropractor,
    'field_message' => $message_value,
  ]);
  $patient_message->save();
}

function EditMenuItem($entity)
{
  $field_assigned_clinic = $entity->get("field_assigned_clinic")->getValue();
  if ($field_assigned_clinic) {
    $entity->set("field_my_clinic", array("target_id" => $field_assigned_clinic[0]["target_id"]));
    $entity->save();
  }

}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
function custom_module_user_presave(EntityInterface $entity)
{
  // The headless registrar creates the clinic/location transactionally itself.
  if ($entity->isNew() && \Drupal::hasService('headless_subscriptions.registration')
      && \Drupal::service('headless_subscriptions.registration')->isRegistering()) {
    return;
  }

  // Explicit sponsored doctors preserve their primary reference and existing clinic.
  if (\Drupal::hasService('headless_subscriptions.repository')
      && \Drupal::service('headless_subscriptions.repository')->member((int) $entity->id())) {
    return;
  }

  // Set field_chiropractor if user has the role.
  if (in_array('chiropractor_active_', $entity->getRoles())) {
    $entity->set('field_chiropractor', $entity->id());
  }

  // Set program day fields if program start date is available.
  $start_date = $entity->get('field_program_start_date')->value;
  if ($start_date) {
    $cMServices = \Drupal::service('custom_module.services');
    $day = $cMServices->computeProgramStartDate($start_date);

    $entity->set('field_user_current_program_day_c', $day);
    $entity->set('field_current_program_day', $day);
    $entity->set('field_program_day', $day);
  }

  // Handle new user registration logic.
  if ($entity->isNew()) {
    $roles = $entity->getRoles();

    if (in_array('anonymous', $roles) && !in_array('enrolled_patient', $roles)) {
      $fullname = $entity->get('field_full_name')->value;
      $subscribers = $entity->get('field_chiropractor_subscribers')->getValue();

      if (!in_array('chiropractor_active_', $roles) && empty($subscribers)) {
        // Create new clinic and location.
        $entity_result = createClinicAndClinicLocation($fullname, $entity->getEmail(), $entity->id());

        if (!empty($entity_result['new_clinic_id'])) {
          $entity->set('field_clinic', ['target_id' => $entity_result['new_clinic_id']]);
        }

        // Add default inactive chiropractor and subscriber role.
        $entity->addRole('subscriber');
        $entity->addRole('chiropractor_inactive_');
      }
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 */
function custom_module_user_insert(EntityInterface $entity)
{
  // Only proceed if user has chiropractor_inactive_ role
  if (!in_array('chiropractor_inactive_', $entity->getRoles())) {
    return;
  }

  // Update clinic ownership if clinic was created during presave.
  $clinic_id = $entity->get('field_clinic')->target_id;

  if (!empty($clinic_id)) {
    // Load and update clinic owner using entity type manager.
    $storage = \Drupal::entityTypeManager()->getStorage('clinic');
    $clinic = $storage->load($clinic_id);

    if ($clinic) {
      $current_owner = $clinic->getOwnerId();
      // Only update if owner is 1 or NULL
      if ($current_owner == 1 || is_null($current_owner)) {
        $clinic->setOwnerId($entity->id());
        $clinic->save();
      }

      // Find and update associated clinic location.
      $query = \Drupal::entityQuery('clinic')
        ->condition('type', 'clinic_location')
        ->condition('field_clinic', $clinic_id)
        ->accessCheck(FALSE);
      $location_ids = $query->execute();

      if (!empty($location_ids)) {
        $location = $storage->load(reset($location_ids));
        if ($location) {
          $location_owner = $location->getOwnerId();
          // Only update if owner is 1 or NULL
          if ($location_owner == 1 || is_null($location_owner)) {
            $location->setOwnerId($entity->id());
            $location->save();
          }
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for views-view.html.twig.
 */

function custom_module_preprocess_views_view(&$variables)
{
  $view = $variables['view'];
  if ($view->id() == 'summary_laser_sessions' && $view->current_display == 'embed_1' || $view->id() == 'summary_laser_sessions' && $view->current_display == 'embed_2' || $view->id() == 'summary_laser_sessions' && $view->current_display == 'embed_3') {
    $output = \Drupal::service('renderer')->render($variables['rows']);
    $variables['rows'] = [
      '#markup' => '<div class="custom-wrapper row">' . $output . '</div>',
    ];
  }
}

/**
 * Implements hook_preprocess_HOOK() for views-view-field.html.twig.
 */
function custom_module_preprocess_views_view_field(&$variables)
{
  $view = $variables['view'];
  $field = $variables['field'];

  if ($view->id() == 'commerce_products' && $view->current_display == 'page_3' && $field->options['id'] == 'type') {
    $badges = [
      'chironutraceutical_variations' => ['shipping', 'Shipping Available'],
      'chironutraceutical_ns' => ['pickup', 'Pickup Only'],
    ];

    $variation_type = $field->getValue($variables['row']);
    $variables['output'] = '';

    if (isset($badges[$variation_type])) {
      [$modifier, $label] = $badges[$variation_type];
      $variables['output'] = [
        '#type' => 'html_tag',
        '#tag' => 'span',
        '#value' => $label,
        '#attributes' => [
          'class' => ['product-badge', 'product-badge--' . $modifier],
        ],
      ];
    }
  }

  // Each row of this view represents a single product variation (joined via
  // the variations_target_id relationship). The default "Add to cart form"
  // formatter operates on the product's full variations field, which falls
  // back to a "Please select" dropdown whenever the product has variations
  // of more than one type. Replace it with a form scoped to this row's
  // specific variation, so no selector is shown.
  if ($view->id() == 'commerce_products' && $view->current_display == 'page_3' && $field->options['id'] == 'variations_target_id') {
    $row = $variables['row'];
    $variation = $row->_relationship_entities['variations_target_id'] ?? NULL;

    if ($variation) {
      $variables['output'] = [
        '#lazy_builder' => [
          'custom_module.product_variation_lazy_builders:addToCartForm', [
            $variation->id(),
            (bool) ($field->options['settings']['combine'] ?? FALSE),
            $variation->language()->getId(),
          ],
        ],
        '#create_placeholder' => TRUE,
      ];
    }
  }
}

function custom_module_block_access(Block $block, $operation, AccountInterface $account)
{
  $hero_image_exists = "";
  if ($operation === 'view' && $block->getPluginId() === 'views_block:recipes-block_3') {
    $user = User::load(\Drupal::currentUser()->id());
    $clinic = $user->get("field_clinic")->getValue();
    if ($clinic) {
      $clinic_id = $clinic[0]["target_id"];
      $storage = \Drupal::service('entity_type.manager')->getStorage('clinic');
      $clinic_entity = $storage->load($clinic_id);
      $field_hide_shared_resources = $clinic_entity->get('field_hide_shared_resources')->getValue();
      if ($field_hide_shared_resources) {
        if ($field_hide_shared_resources[0]["value"] == 0) {
          $hero_image_exists = true;
        } else {
          $hero_image_exists = false;
        }
      }
    }
    return AccessResult::forbiddenIf($hero_image_exists == FALSE)->addCacheableDependency($block);
  }

  if ($operation === 'view' && $block->getPluginId() === 'views_block:recipes-block_2') {
    $user = User::load(\Drupal::currentUser()->id());
    $clinic = $user->get("field_clinic")->getValue();
    if ($clinic) {
      $clinic_id = $clinic[0]["target_id"];
      $storage = \Drupal::service('entity_type.manager')->getStorage('clinic');
      $clinic_entity = $storage->load($clinic_id);
      $field_hide_shared_resources = $clinic_entity->get('field_hide_shared_resources')->getValue();
      if ($field_hide_shared_resources) {
        if ($field_hide_shared_resources[0]["value"] == 1) {
          $hero_image_exists = true;
        } else {
          $hero_image_exists = false;
        }
      }
    }
    return AccessResult::forbiddenIf($hero_image_exists == FALSE)->addCacheableDependency($block);
  }
  if ($operation === 'view' && $block->getPluginId() === 'views_block:training-block_1') {
    $user = User::load(\Drupal::currentUser()->id());
    $clinic = $user->get("field_clinic")->getValue();
    if ($clinic) {
      $clinic_id = $clinic[0]["target_id"];
      $storage = \Drupal::service('entity_type.manager')->getStorage('clinic');
      $clinic_entity = $storage->load($clinic_id);
      $field_hide_shared_resources = $clinic_entity->get('field_hide_shared_resources')->getValue();
      if ($field_hide_shared_resources) {
        if ($field_hide_shared_resources[0]["value"] == 0) {
          $hero_image_exists = true;
        } else {
          $hero_image_exists = false;
        }
      }
    }
    return AccessResult::forbiddenIf($hero_image_exists == FALSE)->addCacheableDependency($block);
  }

  if ($operation === 'view' && $block->getPluginId() === 'views_block:training-block_2') {
    $user = User::load(\Drupal::currentUser()->id());
    $clinic = $user->get("field_clinic")->getValue();
    if ($clinic) {
      $clinic_id = $clinic[0]["target_id"];
      $storage = \Drupal::service('entity_type.manager')->getStorage('clinic');
      $clinic_entity = $storage->load($clinic_id);
      $field_hide_shared_resources = $clinic_entity->get('field_hide_shared_resources')->getValue();
      if ($field_hide_shared_resources) {
        if ($field_hide_shared_resources[0]["value"] == 1) {
          $hero_image_exists = true;
        } else {
          $hero_image_exists = false;
        }
      }
    }
    return AccessResult::forbiddenIf($hero_image_exists == FALSE)->addCacheableDependency($block);
  }

  return AccessResult::neutral();
}


