function custom_module_preprocess_status_messages(&$variables)
{
  if (isset($variables['message_list']['error'])) {
    $error_messages = $variables['message_list']['error'];
    foreach ($error_messages as $delta => $message) {
      if (strpos((string) $message, 'You already have the Chiropractor (Active) role.') !== FALSE) {
        $current_user = \Drupal::currentUser();
        $uid = $current_user->id();
        $url = Url::fromRoute('entity.user.canonical', ['user' => $uid]);
        $x = $url->toString();
        $subscription_link = "<a href='" . $x . "/subscriptions' target='_blank'>here</a>";
        $video_link = "<a href=/video/explaination target='_blank'>here</a>";
        $user = User::load($uid);
        $field_chiropractor_subscribers = $user->get("field_chiropractor_subscribers")->getValue();
        if (empty($field_chiropractor_subscribers)) {
          $html = "To upgrade or downgrade your subscription, you must first cancel your existing subscription and then purchase the new subscription. No patient data will be lost by performing this action. If you are downgrading, you must archive enough enrolled patients to meet the criteria for the subscription level you are requesting (for NEWBIE you must have 3 or fewer enrolled patients to downgrade - For ROOKIE you must have 9 or fewer enrolled patients to downgrade.) When upgrading, you will be charged a pro-rated amount if you are upgrading mid billing cycle. To get started please cancel your current subscription click " . $subscription_link . ". To watch a video on how to perform an upgrade/downgrade click " . $video_link . ".";
        } else {
          $primary_subscriber_id = $field_chiropractor_subscribers[0]['target_id'];
          $primary_subscriber = User::load($primary_subscriber_id);
          $primary_subscriber_full_name = $primary_subscriber->get("field_full_name")->getValue();
          $fullname = $primary_subscriber_full_name[0]["value"];
          $current_path = \Drupal::service('path.current')->getPath();
          $path_args = explode('/', $current_path);
          $product_id = isset($path_args[2]) ? $path_args[2] : NULL;
          $detach_link = "<a href=/detach?product_id=" . $product_id . "&name=" . $fullname . " target='_blank'>Click here to detach your account</a>";
          $html = "You are linked to a primary user account. To subscribe this product, please detach yourself from the primary account. " . $detach_link . " or contact support for assistance.";
        }
        $html = Markup::create($html);
        $variables['message_list']['error'][$delta] = $html;
      }
    }
  }
}



