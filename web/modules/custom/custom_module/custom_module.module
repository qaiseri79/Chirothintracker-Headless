/**
 * Implements hook_cron().
 *
 * TWO-QUEUE SEQUENCING:
 *
 * Queue 1: set_user_current_program_day
 *   - Queued once per day. Updates field_program_day etc. for all patients.
 *   - Uses isolated state keys: program_day_total_users, program_day_users_processed.
 *   - When complete, sets ready_to_send_daily_messages = TRUE.
 *
 * Queue 2: send_standard_daily_messages
 *   - Only queued after Queue 1 fully completes (ready flag = TRUE).
 *   - Uses isolated state keys: daily_msg_* (never overlaps with Queue 1 counters).
 *   - On completion, logs 4 summary rows.
 */
function custom_module_cron()
{
  $state = \Drupal::state();
  $drupal_timezone = \Drupal::config('system.date')->get('timezone.default');
  $date = new DrupalDateTime('now', new \DateTimeZone($drupal_timezone));
  $today = $date->format('Y-m-d');

  // ---------------------------------------------------------------------------
  // STEP 1 — PROGRAM DAY UPDATE QUEUE
  // ---------------------------------------------------------------------------

  $last_queued_date = $state->get('custom_module.last_queued_date', '');
  if ($last_queued_date !== $today) {
    // New day — reset all daily flags and clear log tracking lists.
    $state->set('custom_module.users_queued_today', FALSE);
    $state->set('custom_module.ready_to_send_daily_messages', FALSE);
    $state->set('custom_module.last_queued_date', $today);

    foreach ([
      'custom_module.custom_sent_emails',
      'custom_module.custom_failed_emails',
      'custom_module.custom_skipped_reasons',
      'custom_module.standard_sent_emails',
      'custom_module.standard_failed_emails',
      'custom_module.standard_skipped_reasons',
      'custom_module.general_skipped_reasons',
    ] as $key) {
      $state->delete($key);
    }
  }

  $already_queued = $state->get('custom_module.users_queued_today', FALSE);
  if (!$already_queued) {
    $query = \Drupal::entityQuery('user')
      ->condition('status', 1)
      ->condition('roles', 'enrolled_patient')
      ->exists('field_program_start_date')
      ->accessCheck(FALSE);

    $uids = $query->execute();

    if (!empty($uids)) {
      $queue = \Drupal::service('queue')->get('set_user_current_program_day');
      foreach ($uids as $uid) {
        $queue->createItem(['uid' => $uid]);
      }

      $state->set('custom_module.users_queued_today', TRUE);

      // Isolated counters for Queue 1 only.
      $state->set('custom_module.program_day_total_users', count($uids));
      $state->set('custom_module.program_day_users_processed', 0);

      \Drupal::logger('custom_module')->notice(
        '@count users queued for program day update.',
        ['@count' => count($uids)]
      );
    } else {
      \Drupal::logger('custom_module')->notice('No enrolled_patient users found for program day update.');
    }
  }

  // ---------------------------------------------------------------------------
  // STEP 2 — DAILY MESSAGES QUEUE
  // Only runs once Queue 1 is fully complete (ready flag = TRUE).
  // Guarded by daily_messages_sent_date so it only queues once per day.
  // ---------------------------------------------------------------------------

  $ready = $state->get('custom_module.ready_to_send_daily_messages', FALSE);
  $last_sent_date = $state->get('custom_module.daily_messages_sent_date', '');

  if ($ready && $last_sent_date !== $today) {
    $query = \Drupal::entityQuery('user')
      ->condition('status', 1)
      ->condition('roles', 'enrolled_patient')
      ->exists('field_program_start_date')
      ->accessCheck(FALSE);

    // Only users who have not opted out of email.
    $group = $query->orConditionGroup()
      ->notExists('field_email_optout')
      ->condition('field_email_optout', 0);

    $query->condition($group);
    $uids = $query->execute();

    \Drupal::logger('daily_messages_uids')->notice(
      'Daily messages UIDs: @uids',
      ['@uids' => !empty($uids) ? implode(', ', $uids) : 'none']
    );

    if (!empty($uids)) {
      $queue = \Drupal::service('queue')->get('send_standard_daily_messages');
      foreach ($uids as $uid) {
        $queue->createItem(['uid' => $uid]);
      }

      // Close the gate and stamp the date immediately so a second cron run
      // mid-batch doesn't re-queue the same users.
      $state->set('custom_module.ready_to_send_daily_messages', FALSE);
      $state->set('custom_module.daily_messages_sent_date', $today);

      // Isolated counters for Queue 2 only.
      $state->set('custom_module.daily_msg_total_users', count($uids));
      $state->set('custom_module.daily_msg_users_processed', 0);
      $state->set('custom_module.daily_msg_users_sent', 0);
      $state->set('custom_module.daily_msg_users_skipped', 0);
      $state->set('custom_module.daily_msg_skipped_no_custom', 0);
      $state->set('custom_module.daily_msg_skipped_no_term', 0);

      // Reset categorized log tracking lists for the new batch.
      foreach ([
        'custom_module.custom_sent_emails',
        'custom_module.custom_failed_emails',
        'custom_module.custom_skipped_reasons',
        'custom_module.standard_sent_emails',
        'custom_module.standard_failed_emails',
        'custom_module.standard_skipped_reasons',
        'custom_module.general_skipped_reasons',
      ] as $key) {
        $state->delete($key);
      }

      \Drupal::logger('daily_messages')->notice(
        '@count users queued for standard daily messages.',
        ['@count' => count($uids)]
      );
    } else {
      \Drupal::logger('daily_messages')->notice('No users found for daily messages.');
    }
  }

function custom_module_mail_alter(&$message)
{
  switch ($message['key']) {
    case 'register_admin_created':
    case 'register_no_approval_required':
    case 'register_pending_approval':
    case 'register_pending_approval_admin':
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed; delsp=yes';
      foreach ($message['body'] as $key => $body) {
        $message['body'][$key] = new FormattableMarkup($body, []);
      }
      break;

  }
}

/**
 * Implements hook_mail().
 */
function custom_module_mail($key, &$message, $params)
{
  $options = [
    'langcode' => $message['langcode'],
  ];
  switch ($key) {
    case 'message_email':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('@subject', ['@subject' => $params['subject']], $options);
      $message['body'][] = $params['message'];
      break;

    case 'order_notification':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('@subject', ['@subject' => $params['subject']], $options);
      $message['body'][] = $params['message'];
      break;

    case 'subscription_trial_ending':
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed; delsp=yes';
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('@subject', ['@subject' => $params['subject']], $options);
      $message['body'][] = new FormattableMarkup($params['body'], []);
      break;
  }
}

function custom_module_form_commerce_order_item_add_to_cart_form_alter(&$form, FormStateInterface $form_state, $form_id)
{
  $current_user = \Drupal::currentUser();
  $user_id = $current_user->id();
  if ($current_user->hasRole('chiropractor_active_') && $current_user->hasRole('chiropractor_inactive_')) {
    $selectedVariationId = $form_state->get('selected_variation');
    $subscription_storage = \Drupal::entityTypeManager()->getStorage('commerce_subscription');
    $query = $subscription_storage->getQuery();
    $query
      ->condition('uid', $user_id)
      ->condition('state', 'active')
      ->accessCheck(FALSE);
    $subscription_ids = $query->execute();
    $subscription_id = reset($subscription_ids);
    $subscription = $subscription_storage->load($subscription_id);
    if ($subscription) {
      $purchased_product = $subscription->get("purchased_entity")->getValue()[0]["target_id"];
      if ($purchased_product == $selectedVariationId) {
        $form['actions']['submit']['#attributes']['disabled'] = 'disabled';
      }
    }
  } else if (!$current_user->hasRole('chiropractor_active_') && $current_user->hasRole('chiropractor_inactive_')) {
    $form['#validate'][] = 'custom_module_add_to_cart_custom_validation';
  }
  if ($current_user->hasRole('enrolled_patient')) {
    $form['#validate'][] = 'custom_module_add_to_cart_subscriber_payment_method_validation';
    // Add redirect submit handler only for enrolled_patient.
    $form['actions']['submit']['#submit'][] = 'custom_module_add_to_cart_submit';
  }
}
function custom_module_add_to_cart_subscriber_payment_method_validation(array &$form, FormStateInterface $form_state)
{
  $account = User::load(\Drupal::currentUser()->id());
  $chiropractor_id = $account->get("field_chiropractor")->getValue()[0]['target_id'];
  $chiropractor_account = User::load($chiropractor_id);
  if ($chiropractor_account->get('field_payment_machine_name')->isEmpty()) {
    $form_state->setErrorByName('', t("It appears that your chiropractor has not set up a payment method. As a result, purchasing products is currently unavailable. Please contact your chiropractor to configure a payment method and enable product purchases."));
  }
}
function custom_module_add_to_cart_custom_validation(array &$form, FormStateInterface $form_state)
{
  $selectedVariationId = $form_state->get('selected_variation');
  $chiropractor = User::load(\Drupal::currentUser()->id());
  $clinic = $chiropractor->get("field_clinic")->getValue();
  $enrolledPatient = "";
  if ($clinic) {
    $clinic_id = $clinic[0]["target_id"];
    $storage = \Drupal::service('entity_type.manager')->getStorage('clinic');
    if ($clinic_id) {
      $enrolled_patient_count = Views::getView('report_patients');
      $enrolled_patient_count->setDisplay('block_1');
      //$enrolled_patient_count->setArguments([443]);
      $enrolled_patient_count->setArguments([$clinic_id]);
      $enrolled_patient_count->execute();
      $enrolled_patient_count_result = $enrolled_patient_count->result;
      if ($enrolled_patient_count_result) {
        $enrolledPatient = count($enrolled_patient_count_result);
      } else {
        $enrolledPatient = 0;
      }
    }
  }
  $product_limits = [
    '1' => 4,
    '2' => 10,
    '3' => 'unlimited',
    '4' => 'unlimited',
  ];
  if (isset($product_limits[$selectedVariationId])) {
    $current_user_count = $enrolledPatient;
    $result = checkDowngradeLimit($current_user_count, $selectedVariationId, $product_limits);
    if (!$result['can_downgrade']) {
      $form_state->setErrorByName('', t($result['message']));
    }
  }
}

/**
 * Custom submit handler: redirects enrolled_patient back to previous page after add to cart.
 */
function custom_module_add_to_cart_submit(&$form, FormStateInterface $form_state)
{
  $form_state->setRedirect('view.commerce_products.page_3');
}

function checkDowngradeLimit($current_user_count, $target_product, $product_limits)
{
  $product_title = [
    '1' => "NEWBIE - Enrolled Patient Limit: 4",
    '2' => "ROOKIE - Enrolled Patient Limit:10",
    '3' => 'VETERAN - Enrolled Patient Limit: Unlimited',
    '4' => 'ALL PRO - Adds Red Light Tracker - Enrolled Patient Limit: Unlimited',
  ];
  if ($product_limits[$target_product] !== 'unlimited') {
    $target_limit = $product_limits[$target_product];
    if ($current_user_count > $target_limit) {
      $users_to_archive = $current_user_count - $target_limit;
      $archive_url = '/archive/enrollred-patients';
      $link = "<a href=\"$archive_url\" target='_blank'>here</a>";
      return [
        'can_downgrade' => false,
        'message' => "You need to archive $users_to_archive user(s) before downgrading to $product_title[$target_product]. Click $link to archive.",
      ];
    }
  }
  return [
    'can_downgrade' => true,
    'message' => "You can safely downgrade to $target_product.",
  ];
}



function custom_module_form_alter(&$form, FormStateInterface $form_state, $form_id)
{

  // global current user.
  $current_user = \Drupal::currentUser();
  if ($form_id === 'views_exposed_form' && $form['#id'] === 'views-exposed-form-patients-page-1') {
    if (isset($form['field_clinic_location_target_id_verf'])) {

      $user = User::load(\Drupal::currentUser()->id());
      $clinic = $user->get("field_clinic")->getValue();
      if ($clinic) {
        $clinic_id = $clinic[0]["target_id"];
      }
      $clinic_location = Views::getView('my_clinic');
      $clinic_location->setDisplay('entity_reference_3');
      $clinic_location->setArguments([$clinic_id]);
      $clinic_location->execute();
      $clinic_location_result = $clinic_location->result;
      $allowed_options = [];
      if (!empty($clinic_location_result)) {
        foreach ($clinic_location_result as $row) {
          $allowed_options[] = $row->_entity->id();
        }
      }
      $allowed_options[] = 'All';
      if (!empty($form['field_clinic_location_target_id_verf']['#options'])) {
        foreach ($form['field_clinic_location_target_id_verf']['#options'] as $key => $value) {
          if (!in_array((string) $key, array_map('strval', $allowed_options), true)) {
            unset($form['field_clinic_location_target_id_verf']['#options'][$key]);
          }
        }
      }
    }
  }
  if ($form_id == "webform_submission_unsubscribe_add_form") {
    if (in_array('enrolled_patient', $current_user->getRoles())) {
      $user = User::load(\Drupal::currentUser()->id());
      $field_email_optout = $user->get("field_email_optout")->getValue()[0]["value"];
      if ($field_email_optout == 1) {
        $form["elements"]["unsubscribe_daily_email"]["#default_value"] = TRUE;
      }
    }
  }
  if ($form_id == "clinic_clinic_location_form" || $form_id == "clinic_clinic_location_edit_form") {
    if (in_array('chiropractor_active_', $current_user->getRoles())) {
      $form['field_clinic']['#disabled'] = TRUE;
      $form['uid']['#disabled'] = TRUE;
    }
  }
  if ($form_id == "webform_submission_patient_account_add_form") {
    $g_purchased = GlobalPurchasedEntity();
    $options = $form["elements"]["patient_status"]["#options"];
    if ($g_purchased == 1) {
      unset($options['401']);
      unset($options['400']);
      $form["elements"]["patient_status"]["#options"] = $options;
    } else if ($g_purchased == 4) {
      unset($options['402']);
      $form["elements"]["patient_status"]["#options"] = $options;
    }
  }
  if ($form_id == "node_recipe_form" || $form_id == "node_daily_message_form" || $form_id == "node_chirothin_resource_form" || $form_id == "node_training_form" || $form_id == "node_review_messages_form" || $form_id == "node_recipe_edit_form" || $form_id == "node_chirothin_resource_edit_form" || $form_id == "node_training_edit_form" || $form_id == "node_daily_message_edit_form" || $form_id == "node_review_messages_edit_form") {
    if (in_array('chiropractor_active_', $current_user->getRoles())) {
      $user = User::load(\Drupal::currentUser()->id());
      $clinic = $user->get("field_clinic")->getValue();
      if ($clinic) {
        $clinic_id = $clinic[0]["target_id"];
        $form['field_published_to']['widget']["#default_value"][] = $clinic_id;
      }
      $form['#attached']['drupalSettings']['custom_js']['user_role'] = "chiropractor_active_";
      $form['field_published_to']['#attributes']['class'][] = 'hidden';
      $form['revision_information']['#access'] = FALSE;
    } else if (in_array('administrator', $current_user->getRoles())) {
      $form['field_published_to']['widget']['#required'] = TRUE;
    }
  }
  if ($form_id == "node_daily_message_form" || $form_id == "node_daily_message_edit_form") {
    $form['title']['widget'][0]['value']['#required'] = TRUE;
    $form['title']['widget']['#required'] = TRUE;
    $form['title']['#required'] = TRUE;
  }
  if ($form_id == "webform_submission_patient_message_add_form") {
    if (in_array('archived_patient', $current_user->getRoles())) {
      foreach (array_keys($form["elements"]) as $key) {
        unset($form["elements"][$key]);
      }
      unset($form["actions"]);
      $form["elements"]['message'] = [
        '#type' => 'item',
        '#markup' => t('You are not authorized to access this page.'),
      ];
    }
  }
  if ($form_id == "webform_submission_payment_method_edit_form") {
    if (!in_array('administrator', $current_user->getRoles())) {
      $message = t('<strong>Caution:</strong> If you will update the <strong>Merchant ID API Credentials</strong>, will be reviewed by an administrator, who may update this information as needed. The administrator will update your Merchant ID API Credentials. If credentials are wrong, it may prevent your patients from purchasing your products. Please ensure all details are accurate, as changes may affect your payment processing.');
      \Drupal::messenger()->addWarning($message);
    }
  }
  if ($form_id == "commerce_checkout_flow_multistep_default") {
    $order_arg = $form_state->getBuildInfo()['args'][0];
    if ($order_arg == "order_information") {
      if (array_key_exists("order_fields:checkout", $form)) {
        $form['order_fields:checkout']['field_agreement']['widget']['value']['#default_value'] = false;
        $form['order_fields:checkout']['field_signature']['widget'][0]['value']['#states'] = array(
          'visible' => array(
            ':input[name="order_fields:checkout[field_agreement][value]"]' => array(
              'checked' => true,
            ),
          ),
        );
        $file = "/modules/custom/custom_module/files/2025 CTT - SaaS.pdf";
        $order_id = $form['sidebar']['order_summary']['summary']['#arguments'][0] ?? NULL;
        if ($order_id) {
          $order = Order::load($order_id);
          // Now you can access order items
          foreach ($order->getItems() as $order_item) {
            $variation = $order_item->getPurchasedEntity();
            if ($variation && $variation->hasField('billing_schedule') && !$variation->get('billing_schedule')->isEmpty()) {
              $billing_schedule = $variation->get('billing_schedule')->target_id;
              if ($billing_schedule == 'yearly') {
                $file = "/modules/custom/custom_module/files/2025 CTT - SaaS Annual.pdf";
              }
            }
          }
        }
        $form['order_fields:checkout']['agreement_condition'] = [
          '#type' => 'markup',
          '#markup' => '<div class="custom-html-class"><a href="' . $file . '" target="_blank">Terms & conditions</a></div>',
          '#weight' => -1
        ];
      }
      if (isset($form['payment_information']['payment_method'])) {
        $current_user = \Drupal::currentUser();
        $user_payment_methods = \Drupal::entityTypeManager()
          ->getStorage('commerce_payment_method')
          ->loadByProperties(['uid' => $current_user->id()]);

        $user_payment_method_ids = [];
        foreach ($user_payment_methods as $payment_method) {
          $user_payment_method_ids[] = $payment_method->id();
        }

        if ($current_user->hasRole('enrolled_patient')) {
          $account = User::load($current_user->id());
          $chiropractor_id = $account->get('field_chiropractor')->getValue()[0]['target_id'];
          $chiropractor_account = User::load($chiropractor_id);

          $field_value = $chiropractor_account->get('field_payment_machine_name')->getValue();

          if (empty($field_value) || empty($field_value[0]['value'])) {
            throw new \Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException('You are not allowed to access this form.');
          }

          $raw_name = $field_value[0]['value'];
          $prefixed_name = "new--credit_card--" . $raw_name;
          $options = $form['payment_information']['payment_method']['#options'];

          // Check prefixed key first, then fall back to raw value
          if (array_key_exists($prefixed_name, $options)) {
            $payment_machine_name = $prefixed_name;
          } elseif (array_key_exists($raw_name, $options)) {
            $payment_machine_name = $raw_name;
          } else {
            throw new \Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException('You are not allowed to access this form.');
          }

          foreach ($form['payment_information']['payment_method']['#options'] as $key => $value) {
            if ($key !== $payment_machine_name && !in_array($key, $user_payment_method_ids)) {
              unset($form['payment_information']['payment_method']['#options'][$key]);
            }
          }

          if (isset($form['payment_information']['payment_method']['#options'][$payment_machine_name])) {
            $form['payment_information']['payment_method']['#default_value'] = $payment_machine_name;
            $form['#attached']['drupalSettings']['custom_module'] = [
              'selected_payment_method' => $payment_machine_name,
              'is_initial_load' => TRUE,
            ];
          }

          $form['#attached']['library'][] = 'custom_module/payment_method_preselect';
        }
      }
    }
  }
  if ($form_id == "commerce_payment_gateway_add_form") {
    $sid = \Drupal::request()->query->get('sid');
    if ($sid) {
      $submission = WebformSubmission::load($sid);
      $data = $submission->getData();
      $form['label']['#default_value'] = $data['name'];
    }
    array_unshift($form['actions']['submit']['#submit'], 'custom_payment_alter_submit_handler');
  }
  if ($form_id == "commerce_product_chironutraceutical_add_form" || $form_id == "commerce_product_chironutraceutical_edit_form") {
    if (in_array('chiropractor_active_', $current_user->getRoles())) {
      $form['changed']['#access'] = FALSE;
      $form['author']['#access'] = FALSE;
      $form['field_product_type']['#access'] = FALSE;
      $form['stores']['widget']['target_id']['#default_value'] = [2];
    }

    $form['body']['widget']['#after_build'][] = 'custom_module_remove_textarea_help';
    $form['field_short_detail']['widget']['#after_build'][] = 'custom_module_remove_textarea_help';
  }
  if ($form_id == "commerce_payment_method_add_form") {
    $payment_machine_name = "";
    if ($current_user->hasRole('enrolled_patient')) {
      $user_id = $current_user->id();
      $account = User::load($user_id);
      $chiropractor_id = $account->get("field_chiropractor")->getValue()[0]['target_id'];
      $chiropractor_account = User::load($chiropractor_id);
      $payment_machine_name = $chiropractor_account->get('field_payment_machine_name')->getValue();
      if (!empty($payment_machine_name)) {
        $payment_machine_name = "new--credit_card--" . $payment_machine_name[0]["value"];
      }
    }
    if ($current_user->hasRole('chiropractor_active_') || $current_user->hasRole('chiropractor_inactive_')) {
      $payment_machine_name = "new--credit_card--authorize_net";
    }
    //if(array_key_exists($payment_machine_name, $form['payment_method']['#options'])){
    if (is_string($payment_machine_name) && array_key_exists($payment_machine_name, $form['payment_method']['#options'])) {
      foreach ($form['payment_method']['#options'] as $key => $value) {
        if ($key != $payment_machine_name) {
          unset($form['payment_method']['#options'][$key]);
        }
      }
      $form['payment_method']['#default_value'] = $payment_machine_name;
      $form['#attached']['drupalSettings']['custom_module_add_payment'] = [
        'payment_machine_name' => $payment_machine_name,
        'is_initial_load' => TRUE,
      ];
      $form['#attached']['library'][] = 'custom_module/add_payment_method_preselect';
    } else {
      //  foreach ($form['payment_method']['#options'] as $key => $value) {
      //          unset($form['payment_method']['#options'][$key]);
