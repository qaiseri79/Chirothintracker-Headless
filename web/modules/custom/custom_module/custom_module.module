/**
 * Implements hook_ENTITY_TYPE_presave() for commerce_shipping_method.
 */
function custom_module_commerce_shipping_method_presave(ShippingMethodInterface $entity)
{
  // Only for NEW entity.
  if (!$entity->isNew()) {
    return;
  }

  // Check user role.
  $current_user = \Drupal::currentUser();
  if (!in_array('chiropractor_active_', $current_user->getRoles())) {
    return;
  }

  // Set store (store ID = 2)
  $entity->set('stores', [
    ['target_id' => 2],
  ]);

  // Set condition: order_product_type = chironutraceutical
  $entity->set('conditions', [
    [
      'target_plugin_id' => 'order_product_type',
      'target_plugin_configuration' => [
        'product_types' => ['chironutraceutical'],
      ],
    ],
  ]);
}

/**
 * Implements hook_ENTITY_TYPE_insert() for commerce_shipping_method.
 */
function custom_module_commerce_shipping_method_insert(ShippingMethodInterface $entity)
{

  // Check user role.
  $current_user = \Drupal::currentUser();
  if (!in_array('chiropractor_active_', $current_user->getRoles())) {
    return;
  }
  $subscriber = \Drupal::service('custom_module.services')->getSubscriberByChiropractor($current_user->id());

  // Load full user entity.
  if (!$subscriber) {
    return;
  }

  // Get existing values.
  $existing = $subscriber->get('field_shipping_methods')->getValue();

  // Add new shipping method reference.
  $existing[] = [
    'target_id' => $entity->id(),
  ];

  // Set back and save user.
  $subscriber->set('field_shipping_methods', $existing);
  $subscriber->save();
}

/**
 * Implements hook_ENTITY_TYPE_access() for commerce_shipping_method.
 */
function custom_module_commerce_shipping_method_access(ShippingMethodInterface $entity, $operation, AccountInterface $account)
{

  // Apply only to view & update.
  if (!in_array($operation, ['view', 'update'])) {
    return AccessResult::neutral();
  }

  // Apply ONLY to chiropractor_active_ role.
  if (!in_array('chiropractor_active_', $account->getRoles())) {
    return AccessResult::neutral();
  }

  // Resolve subscriber via service.
  $subscriber = \Drupal::service('custom_module.services')
    ->getSubscriberByChiropractor($account->id());

  if (!$subscriber) {
    return AccessResult::forbidden()->cachePerUser();
  }

  // Get subscriber's shipping method IDs.
  $ids = array_column(
    $subscriber->get('field_shipping_methods')->getValue(),
    'target_id'
  );

  // Allow only if subscriber owns this shipping method.
  return in_array($entity->id(), $ids)
    ? AccessResult::allowed()->cachePerUser()
    : AccessResult::forbidden()->cachePerUser();
}

/**
 * Implements hook_ENTITY_TYPE_delete() for commerce_shipping_method.
 */
function custom_module_commerce_shipping_method_delete(ShippingMethodInterface $entity)
{

  $shipping_method_id = $entity->id();

  // Load users who reference this shipping method.
  $uids = \Drupal::entityQuery('user')
    ->condition('field_shipping_methods.target_id', $shipping_method_id)
    ->accessCheck(FALSE)
    ->execute();

  if (empty($uids)) {
    return;
  }

  $users = User::loadMultiple($uids);

  foreach ($users as $user) {
    $values = $user->get('field_shipping_methods')->getValue();

    // Remove matching shipping method.
    $filtered = array_filter($values, function ($item) use ($shipping_method_id) {
      return $item['target_id'] != $shipping_method_id;
    });

    // Re-index array.
    $filtered = array_values($filtered);

    $user->set('field_shipping_methods', $filtered);
    $user->save();
  }
}

/**
 * Alter a view at the very beginning of Views processing.
 *
 * Output can be added to the view by setting $view->attachment_before
 * and $view->attachment_after.
 *
 * @param \Drupal\views\ViewExecutable $view
 *   The view object about to be processed.
 * @param string $display_id
 *   The machine name of the active display.
 * @param array $args
 *   An array of arguments passed into the view.
 *
 * @see \Drupal\views\ViewExecutable
 */
function custom_module_views_pre_view(ViewExecutable $view, $display_id, array &$args)
{

  if ($view->id() === 'export_patients') {
    $current_user = \Drupal::currentUser();
    $user = User::load($current_user->id());
    $clinic_id = $user->get('field_clinic')->target_id;
    if ($clinic_id) {
      $args[0] = $clinic_id;
    }
    return;
  }

  if ($view->id() == 'commerce_products' && $display_id == 'page_3') {
    // Resolve subscriber via service.
    $subscriber = \Drupal::service('custom_module.services')
      ->getSubscriberByPatient(\Drupal::currentUser()->id());

    if (!$subscriber) {
      return;
    }
    $args[0] = $subscriber->id();

    // set product fullfillment by clinic.
    $clinic = $subscriber->get('field_clinic')->entity;
    if ($clinic && $clinic->hasField('field_fulfillment_type') && !$clinic->get('field_fulfillment_type')->isEmpty()) {
      $fulfillment_type = $clinic->get('field_fulfillment_type')->value;
      if ($fulfillment_type == 'shipping') {
        $args[1] = 'chironutraceutical_variations';
      } elseif ($fulfillment_type == 'pickup') {
        $args[1] = 'chironutraceutical_ns';
      } else {
        $args[1] = 'all';
      }
    }
  }

  if ($view->id() !== 'shipping_methods' || $display_id !== 'page_1') {
    return;
  }

  $current_user = \Drupal::currentUser();

  // Apply only for chiropractor_active_ role.
  if (!in_array('chiropractor_active_', $current_user->getRoles())) {
    return;
  }

  // Resolve subscriber via service.
  $subscriber = \Drupal::service('custom_module.services')
    ->getSubscriberByChiropractor($current_user->id());

  if (!$subscriber) {
    return;
  }

  // Get shipping method IDs from subscriber.
  $shipping_ids = array_column(
    $subscriber->get('field_shipping_methods')->getValue(),
    'target_id'
  );

  // Remove duplicates.
  $shipping_ids = array_unique($shipping_ids);

  // Concatenate with "+" for contextual filter.
  if (!empty($shipping_ids)) {
    $args[0] = implode('+', $shipping_ids);
  }
}

/**
 * Implements hook_form_alter() for the Commerce checkout form.
 *
 * Filters shipping methods shown to a patient to only those
 * owned by their assigned chiropractor (subscriber).
 */
function custom_module_form_commerce_checkout_flow_multistep_default_alter(&$form, FormStateInterface $form_state, $form_id)
{
  $current_user = \Drupal::currentUser();
  $user = User::load($current_user->id());

  if (
    !$user ||
    !$user->hasRole('enrolled_patient') ||
    !$user->hasField('field_chiropractor') ||
    $user->get('field_chiropractor')->isEmpty()
  ) {
    return;
  }

  $chiropractor_id = $user->get('field_chiropractor')->target_id;
  $subscriber = \Drupal::service('custom_module.services')
    ->getSubscriberByChiropractor($chiropractor_id);

  // No subscriber found OR subscriber has no shipping methods
  if (
    !$subscriber ||
    !$subscriber->hasField('field_shipping_methods') ||
    $subscriber->get('field_shipping_methods')->isEmpty()
  ) {
    _custom_module_clear_shipping_options($form);
    _custom_module_block_checkout($form);
    return;
  }

  $allowed_ids = array_map('intval', array_column(
    $subscriber->get('field_shipping_methods')->getValue(),
    'target_id'
  ));

  // KEY FIX: Load order and fix stored shipment BEFORE form renders
  // so Order summary reads the correct shipping amount.
  $checkout_flow = $form_state->getFormObject();
  if (method_exists($checkout_flow, 'getOrder')) {
    $order = $checkout_flow->getOrder();

    if ($order) {
      $shipment_entities = $order->get('shipments')->referencedEntities();
      $order_needs_save = FALSE;

      foreach ($shipment_entities as $shipment) {
        $current_method_id = (int) $shipment->get('shipping_method')->target_id;

        // Shipment has a disallowed method — fix it.
        if ($current_method_id && !in_array($current_method_id, $allowed_ids, TRUE)) {

          // Load all rates for allowed methods to get the first valid rate.
          /** @var \Drupal\commerce_shipping\ShippingRate[] $valid_rates */
          $valid_rates = [];

          foreach ($allowed_ids as $allowed_method_id) {
            $shipping_method = \Drupal::entityTypeManager()
              ->getStorage('commerce_shipping_method')
              ->load($allowed_method_id);

            if (!$shipping_method) {
              continue;
            }

            /** @var \Drupal\commerce_shipping\Plugin\Commerce\ShippingMethod\ShippingMethodInterface $plugin */
            $plugin = $shipping_method->getPlugin();
            $rates = $plugin->calculateRates($shipment);

            if (!empty($rates)) {
              $valid_rates = array_merge($valid_rates, $rates);
            }
          }

          if (!empty($valid_rates)) {
            $first_rate = reset($valid_rates);
            $shipment->set('shipping_method', $first_rate->getShippingMethodId());
            // FIX: call ->getId() to get string instead of passing object directly.
            $shipment->setShippingService($first_rate->getService()->getId());
            $shipment->setAmount($first_rate->getAmount());
          } else {
            // No valid rates — clear shipment amount.
            $shipment->setAmount(NULL);
            $shipment->set('shipping_method', NULL);
            $shipment->setShippingService(NULL);
          }

          $shipment->save();
          $order_needs_save = TRUE;
        }
      }

      // Recalculate order total once after all shipments updated.
      if ($order_needs_save) {
        $order->recalculateTotalPrice();
        $order->save();
      }
    }
  }

  // Now filter form radios display.
  if (empty($form['shipping_information']['shipments'])) {
    return;
  }

  $shipments = &$form['shipping_information']['shipments'];

  foreach (Element::children($shipments) as $shipment_index) {
    if (empty($shipments[$shipment_index]['shipping_method'])) {
      continue;
    }

    foreach (Element::children($shipments[$shipment_index]['shipping_method']) as $method_group_key) {
      $radios = &$form['shipping_information']['shipments'][$shipment_index]['shipping_method'][$method_group_key][0];

      foreach (Element::children($radios) as $option_key) {
        $method_id = (int) explode('--', $option_key)[0];
        if (!in_array($method_id, $allowed_ids, TRUE)) {
          unset($radios[$option_key]);
          unset($radios['#options'][$option_key]);
        }
      }

      // Reverse options order — preserving keys so values stay mapped correctly.
      $radios['#options'] = array_reverse($radios['#options'], TRUE);

      // Always set default to first option after reversing.
      $radios['#default_value'] = array_key_first($radios['#options'] ?? []) ?: NULL;
    }
  }
}

/**
 * Helper: shows error message and disables checkout submit button.
 */
function _custom_module_block_checkout(&$form)
{
  $form['shipping_information']['no_shipping_warning'] = [
    '#type' => 'markup',
    '#markup' => '<div class="alert alert-danger alert-dismissible fade show" role="alert">' .
      '<p><b>' . t('No shipping method has been added by Chiropractor.') . '</b></p>' .
      '<p>' . t('Please ask them to add at least one shipping method before placing an order.') . '</p>' .
      '<span type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></span></div>',
    '#weight' => -10,
  ];

  $form['actions']['next']['#disabled'] = TRUE;
  $form['#validate'][] = 'custom_module_checkout_no_shipping_validate';
}

/**
 * Validation handler: server-side safety net.
 */
function custom_module_checkout_no_shipping_validate(&$form, FormStateInterface $form_state)
{
  $form_state->setErrorByName(
    'shipping_information',
    t('No shipping method has been added by Chiropractor. Please ask them to add at least one shipping method before placing an order.')
  );
}

/**
 * Helper: removes ALL shipping method options from the form.
 * Prevents other subscribers' methods from leaking through.
 */
function _custom_module_clear_shipping_options(&$form)
{
  if (empty($form['shipping_information']['shipments'])) {
    return;
  }

  $shipments = &$form['shipping_information']['shipments'];

  foreach (Element::children($shipments) as $shipment_index) {
    if (empty($shipments[$shipment_index]['shipping_method'])) {
      continue;
    }

    $shipping_method = &$shipments[$shipment_index]['shipping_method'];

    foreach (Element::children($shipping_method) as $method_group_key) {
      $radios = &$form['shipping_information']['shipments'][$shipment_index]['shipping_method'][$method_group_key][0];

      // Wipe every radio option.
      foreach (Element::children($radios) as $option_key) {
        unset($radios[$option_key]);
      }

      // Wipe #options array entirely.
      $radios['#options'] = [];
      $radios['#default_value'] = NULL;
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_access() for commerce_order.
 */
function custom_module_commerce_order_access(
  OrderInterface $entity,
  string $operation,
  AccountInterface $account
): AccessResult {

  // Only apply logic for chiropractor_active_ role.
  $roles = $account->getRoles();
  if (!in_array('chiropractor_active_', $roles)) {
    return AccessResult::neutral();
  }

  // Only handle view and update operations.
  if (!in_array($operation, ['view', 'update'])) {
    return AccessResult::forbidden()->cachePerUser();
  }

  // Only apply to "shop" order type.
  if ($entity->bundle() !== 'shop') {
    return AccessResult::forbidden()
      ->cachePerUser()
      ->addCacheableDependency($entity);
  }

  // Check if any item belongs to a product owned by this user.
  foreach ($entity->getItems() as $order_item) {
    $purchased_entity = $order_item->getPurchasedEntity();

    if (!$purchased_entity) {
      continue;
    }

    $product = $purchased_entity->getProduct();

    if ($product && (int) $product->getOwnerId() === (int) $account->id()) {
      // ✅ Own product found — allow view or update.
      return AccessResult::allowed()
        ->cachePerUser()
        ->addCacheableDependency($entity);
    }
  }

  // ❌ No own product in this order — explicitly deny.
  return AccessResult::forbidden()
    ->cachePerUser()
    ->addCacheableDependency($entity);
}

/**
 * Implements hook_ENTITY_TYPE_access() for commerce_shipment.
 */
function custom_module_commerce_shipment_access(
  EntityInterface $entity,
  string $operation,
  AccountInterface $account
): AccessResult {

  $roles = $account->getRoles();
  if (!in_array('chiropractor_active_', $roles)) {
    return AccessResult::neutral();
  }

  if (!in_array($operation, ['view', 'update'])) {
    return AccessResult::forbidden()->cachePerUser();
  }

  // Get the parent order from the shipment.
  /** @var \Drupal\commerce_shipping\Entity\ShipmentInterface $entity */
  $order = $entity->getOrder();

  if (!$order || $order->bundle() !== 'shop') {
    return AccessResult::forbidden()
      ->cachePerUser()
      ->addCacheableDependency($entity);
  }

  // Check if any order item belongs to a product owned by this user.
  foreach ($order->getItems() as $order_item) {
    $purchased_entity = $order_item->getPurchasedEntity();

    if (!$purchased_entity) {
      continue;
    }

    $product = $purchased_entity->getProduct();

    if ($product && (int) $product->getOwnerId() === (int) $account->id()) {
      return AccessResult::allowed()
        ->cachePerUser()
        ->addCacheableDependency($entity)
        ->addCacheableDependency($order);
    }
  }

  return AccessResult::forbidden()
    ->cachePerUser()
    ->addCacheableDependency($entity)
    ->addCacheableDependency($order);
}

/**
 * Implements hook_ENTITY_TYPE_access() for commerce_payment.
 */
function custom_module_commerce_payment_access(
  EntityInterface $entity,
  string $operation,
  AccountInterface $account
): AccessResult {

  $roles = $account->getRoles();
  if (!in_array('chiropractor_active_', $roles)) {
    return AccessResult::neutral();
  }

  if (!in_array($operation, ['view', 'update', 'receive'])) {
    return AccessResult::forbidden()->cachePerUser();
  }

  // Get the parent order from the payment.
  /** @var \Drupal\commerce_payment\Entity\PaymentInterface $entity */
  $order = $entity->getOrder();

  if (!$order || $order->bundle() !== 'shop') {
    return AccessResult::forbidden()
      ->cachePerUser()
      ->addCacheableDependency($entity);
  }

  // Check if any order item belongs to a product owned by this user.
  foreach ($order->getItems() as $order_item) {
    $purchased_entity = $order_item->getPurchasedEntity();

    if (!$purchased_entity) {
      continue;
    }

    $product = $purchased_entity->getProduct();

    if ($product && (int) $product->getOwnerId() === (int) $account->id()) {
      return AccessResult::allowed()
        ->cachePerUser()
        ->addCacheableDependency($entity)
        ->addCacheableDependency($order);
    }
  }

  return AccessResult::forbidden()
    ->cachePerUser()
    ->addCacheableDependency($entity)
    ->addCacheableDependency($order);
}

/**
 * Implements hook_menu_local_actions_alter().
 */
function custom_module_menu_local_actions_alter(&$local_actions)
{
  // Remove the default Commerce "Add variation" button.
  unset($local_actions['entity.commerce_product_variation.add_page']);
}