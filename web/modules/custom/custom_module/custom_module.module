/**
 * Implements hook_entity_access().
 */
function custom_module_entity_access(EntityInterface $entity, $operation, AccountInterface $account)
{
  // Apply only to contact messages.
  if ($entity->getEntityTypeId() === 'contact_message') {
    // Apply only to 'tracking_weight' contact messages.
    if ($entity->bundle() === 'tracking_weight') {

      // Apply the same rule to both update and delete operations.
      if ($operation === 'update' || $operation === 'delete') {
        $current_uid = $account->id();
        $owner_id = $entity->get('uid')->target_id ?? NULL;

        // Check if the message has an owner.
        if ($owner_id) {
          // Allow if current user is the message owner.
          if ($owner_id == $current_uid) {
            return AccessResult::allowed()->cachePerUser();
          }

          // Otherwise, check if current user is the chiropractor of the owner.
          if (
            ($owner = User::load($owner_id)) &&
            ($current_user = User::load($current_uid)) &&
            $account->hasRole('chiropractor_active_')
          ) {
            $owner_chiropractor = $owner->get('field_chiropractor')->target_id ?? NULL;
            $owner_clinic = $owner->get('field_clinic')->target_id ?? NULL;
            $current_clinic = $current_user->get('field_clinic')->target_id ?? NULL;

            if (
              ($owner_chiropractor == $current_uid) ||
              ($owner_clinic && $owner_clinic == $current_clinic)
            ) {
              return AccessResult::allowed()->cachePerUser();
            }
          }
        }
      }
    }

    // Apply only to 'patient_intake' contact messages.
    if (
      $entity->bundle() === 'patient_intake' &&
      ($operation === 'view' || $operation === 'delete') &&
      ($current_user = User::load($account->id())) &&
      $account->hasRole('chiropractor_active_')
    ) {
      $entity_clinic = $entity->get('field_clinic')->target_id ?? NULL;
      $current_clinic = $current_user->get('field_clinic')->target_id ?? NULL;

      // Grant access if both clinics match.
      if ($entity_clinic && $current_clinic && $entity_clinic == $current_clinic) {
        return AccessResult::allowed()->cachePerUser();
      }
    }

    // Apply only to 'patient_attachments' & 'chiropractor_notes' contact messages.
    // View access.
    if (
      in_array($entity->bundle(), ['patient_attachments', 'chiropractor_notes'], TRUE) &&
      $operation === 'view'
    ) {
      $owner_id = $entity->get('uid')->target_id ?? NULL;
      $current_uid = $account->id();

      // Grant access if the owner and current user match.
      if ($owner_id && $owner_id == $current_uid) {
        return AccessResult::allowed()->cachePerUser();
      }

      // Check for clinic-based access if the current user is an active chiropractor.
      if (($owner = User::load($owner_id)) && ($current_owner = User::load($current_uid))) {
        $owner_clinic = $owner->get('field_clinic')->target_id ?? NULL;
        $current_clinic = $current_owner->get('field_clinic')->target_id ?? NULL;

        if ($owner_clinic && $current_clinic && $owner_clinic == $current_clinic) {
          return AccessResult::allowed()->cachePerUser();
        }
      }
    }
    // Update and Delete access to chiropractor Active only. 
    if (
      in_array($entity->bundle(), ['patient_attachments', 'chiropractor_notes'], TRUE) &&
      in_array($operation, ['update', 'delete'], TRUE) && $account->hasRole('chiropractor_active_')
    ) {
      $owner_id = $entity->get('uid')->target_id ?? NULL;
      $current_uid = $account->id();

      // Grant access if the owner and current user match.
      if ($owner_id && $owner_id == $current_uid) {
        return AccessResult::allowed()->cachePerUser();
      }

      // Check for clinic-based access if the current user is an active chiropractor.
      if (($owner = User::load($owner_id)) && ($current_owner = User::load($current_uid))) {
        $owner_clinic = $owner->get('field_clinic')->target_id ?? NULL;
        $current_clinic = $current_owner->get('field_clinic')->target_id ?? NULL;

        if ($owner_clinic && $current_clinic && $owner_clinic == $current_clinic) {
          return AccessResult::allowed()->cachePerUser();
        }
      }
    }

    if ($entity->bundle() === 'ultraslim_profile' || $entity->bundle() === 'zerona_profile' || $entity->bundle() === 'lipolight_profile') {
      // Apply the same rule to both update and delete operations.
      if (($operation === 'update' || $operation === 'delete') && $account->hasRole('chiropractor_active_')) {
        $current_uid = $account->id();
        $owner_id = $entity->get('uid')->target_id ?? NULL;

        // Grant access if the owner and current user match.
        if ($owner_id && $owner_id == $current_uid) {
          return AccessResult::allowed()->cachePerUser();
        }

        // -------------------------------------------------------------
        // check entity created by subscriber and edit by chiropractor.
        // -------------------------------------------------------------
        $chiropractor = User::load($current_uid);
        if ($chiropractor && $chiropractor->hasField('field_chiropractor_subscribers') && !$chiropractor->get('field_chiropractor_subscribers')->isEmpty()) {
          foreach ($chiropractor->get('field_chiropractor_subscribers')->referencedEntities() as $subscriber) {
            if ($subscriber->id() == $owner_id) {
              return AccessResult::allowed()->cachePerUser();
            }
          }
        }

        // -------------------------------------------------------------
        // check entity created by chiropractor and edit by subscriber.
        // -------------------------------------------------------------
        $owner = User::load($owner_id);
        if ($owner && $owner->hasField('field_chiropractor_subscribers') && !$owner->get('field_chiropractor_subscribers')->isEmpty()) {
          foreach ($owner->get('field_chiropractor_subscribers')->referencedEntities() as $subscriber) {
            if ($subscriber->id() == $current_uid) {
              return AccessResult::allowed()->cachePerUser();
            }
          }
        }
      }
    }

    // Update Patient Photos.
    if ($entity->bundle() === 'patient_photos') {
      // Apply the same rule to both update and delete operations.
      if (($operation === 'update' || $operation === 'view') && $account->hasRole('chiropractor_active_')) {
        $current_uid = $account->id();
        $owner_id = $entity->get('uid')->target_id ?? NULL;

        // Grant access if the owner and current user match.
        if ($owner_id && $owner_id == $current_uid) {
          return AccessResult::allowed()->cachePerUser();
        }

        // -------------------------------------------------------------
        // check entity created by subscriber and edit by chiropractor.
        // -------------------------------------------------------------
        $chiropractor = User::load($current_uid);
        if ($chiropractor && $chiropractor->hasField('field_chiropractor_subscribers') && !$chiropractor->get('field_chiropractor_subscribers')->isEmpty()) {
          foreach ($chiropractor->get('field_chiropractor_subscribers')->referencedEntities() as $subscriber) {
            if ($subscriber->id() == $owner_id) {
              return AccessResult::allowed()->cachePerUser();
            }
          }
        }

        // -------------------------------------------------------------
        // check entity created by chiropractor and edit by subscriber.
        // -------------------------------------------------------------
        $owner = User::load($owner_id);
        if ($owner && $owner->hasField('field_chiropractor_subscribers') && !$owner->get('field_chiropractor_subscribers')->isEmpty()) {
          foreach ($owner->get('field_chiropractor_subscribers')->referencedEntities() as $subscriber) {
            if ($subscriber->id() == $current_uid) {
              return AccessResult::allowed()->cachePerUser();
            }
          }
        }
      }
    }
  }

  // Return neutral for other entity types or operations.
  return AccessResult::neutral();
}

/**
 * Implements hook_views_query_alter().
 */
function custom_module_views_query_alter(ViewExecutable $view, QueryPluginBase $query)
{
  if ($view->id() === 'rules_maximum_weight_cs' && $view->current_display === 'block_2') {
    if (!empty($view->args[0])) {
      $uid = $view->args[0];
      $user = User::load($uid);
      if ($user && !$user->get('field_program_start_date')->isEmpty()) {
        $user_date = $user->get('field_program_start_date')->value;
        $alias = $query->ensureTable('contact_message__field_date', 'contact_message');
        $query->addWhere(0, "$alias.field_date_value", $user_date, '>=');
      }
    }
  }
  if ($view->id() == 'new_patients' && $view->current_display == 'page_2') {
    // Enable pure distinct for better performance
    $query->distinct = TRUE;
  }
}


/**
 * Implements hook_views_pre_render().
 */
function custom_module_views_pre_render(ViewExecutable $view)
{
  if ($view->id() === 'laser_patient_details' && $view->current_display === 'page_1') {
    $path = \Drupal::request()->getPathInfo();
    $parts = explode('/', trim($path, '/'));
    $patient_id = NULL;
    if (isset($parts[0]) && $parts[0] === 'details' && isset($parts[1]) && is_numeric($parts[1])) {
      $patient_id = (int) $parts[1];
    }

    $user = \Drupal::currentUser();
    $buttons = '';
    $baseDialogOptions = [
      'attributes' => [
        'class' => ['use-ajax', 'btn', 'btn-success'],
        'data-dialog-type' => "modal",
        'data-dialog-options' => Json::encode([
          'width' => 800,
          'position' => ['my' => 'center', 'at' => 'center'],
          'dialogClass' => "confirmation-dialog",
        ]),
      ]
    ];
    // $url = Url::fromRoute('custom_module.ultraslim_profile', ['user' => $patient_id], $baseDialogOptions);
    // if ($url->access($user)) {
    //   $buttons .= Link::fromTextAndUrl(t('<span class="fa-solid fa-plus"></span> Add UltraSlim Profile'), $url)->toString();
    // }

    $url = Url::fromRoute('custom_module.red_light_therapy_profile', ['user' => $patient_id], $baseDialogOptions);
    if ($url->access($user)) {
      $buttons .= Link::fromTextAndUrl(t('<span class="fa-solid fa-plus"></span> Add Red Light Therapy Profile'), $url)->toString();
    }

    // Update the header plugin content.
    foreach ($view->header as $handler) {
      if ($handler->getPluginId() === 'text') {
        $handler->options['content']['value'] = $buttons;
        $handler->options['content']['format'] = 'full_html';
      }
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for contact_message_patient_intake_delete_form.
 */
function custom_module_form_contact_message_patient_intake_delete_form_alter(&$form, FormStateInterface $form_state, $form_id)
{
  $entity = $form_state->getFormObject()->getEntity();

  if ($entity && $entity->getEntityTypeId() === 'contact_message') {
