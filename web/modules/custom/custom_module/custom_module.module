function custom_module_ajax_refresh_form(array &$form, FormStateInterface $form_state)
{
  // Check if there are errors
  if ($form_state->getErrors()) {
    // Return updated form (with error messages)
    return $form;
  } else {
    // No errors, send AjaxResponse (e.g., close modal + message)
    $response = new AjaxResponse();
    $response->addCommand(new HtmlCommand('#ajax-success-message', '<div class="messages messages--status">Your message has been sent successfully.</div>'));
    $response->addCommand(new CloseModalDialogCommand());
    return $response;
  }
}


function custom_payment_alter_submit_handler(array &$form, FormStateInterface $form_state)
{
  $machine_name = $form['id']['#value'];
  $uid = \Drupal::request()->query->get('uid');
  if ($uid) {
    $account = User::load($uid);
    $account->set('field_payment_machine_name', $machine_name);
    $account->save();
  }
  $sid = \Drupal::request()->query->get('sid');
  if ($sid) {
    $submission = WebformSubmission::load($sid);
    $data = $submission->getData();
    $data['status'] = 'created';
    $submission->setData($data);
    $submission->save();
  }
}

/**
 * Removes the text format help and guidelines under a textarea.
 *
 * This function modifies the render array of a textarea field to hide
 * the text format selector, formatting guidelines, and help text that
 * normally appear below textareas using the Text Format module.
 *
 * @param array $form_element
 *   The render array element of the textarea field.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current state of the form.
 *
 * @return array
 *   The modified render array with the text format UI elements removed.
 */
function custom_module_remove_textarea_help(array $form_element, FormStateInterface $form_state)
{
  // Check if the textarea uses a text format and it exists in the render array.
  if (isset($form_element[0]['format'])) {

    // Remove formatting guidelines and help text.
    unset($form_element[0]['format']['guidelines']);
    unset($form_element[0]['format']['help']);

    // Remove type and theme wrappers to avoid empty containers.
    unset($form_element[0]['format']['#type']);
    unset($form_element[0]['format']['#theme_wrappers']);

    // Hide the format selector dropdown (e.g., Filtered HTML, Full HTML).
    $form_element[0]['format']['format']['#access'] = FALSE;
  }

  return $form_element;
}

