function ultraslim_profile($row_source){
     $data = $row_source;
     if(!empty($data["field_subcutaneous_fat"])){
        $subcutaneous_tids = array_column($data['field_subcutaneous_fat'], 'tid');
     }
      if(!empty($data["field_skin_tightening"])){
        $skin_tids = array_column($data['field_skin_tightening'], 'tid');
     }
    if(!empty($data["field_cellulite"])){
        $cellulite_tids = array_column($data['field_cellulite'], 'tid');
     }
     if(!empty($data["field_treatment_protocol"])){
           $treatment_tids = array_column($data['field_treatment_protocol'], 'tid');
     }
     if(!empty($data['field_before_and_after_photos'])){
           $field_before_and_after_photos = array_column($data['field_before_and_after_photos'], 'fid');
     }else{
            $field_before_and_after_photos = $data['field_before_and_after_photos'];
     }
        $webform_id = 'ultraslim_session';
        $webform = Webform::load($webform_id);
        // Create webform submission.
        $values = [
        'webform_id' => $webform->id(),
        'uid'=> $data['uid'],
        'sid' => $data["entityform_id"],
        'data' => [
        'patient_profile' => !empty($data['field_patient_profile']) ? $data['field_patient_profile'][0]['target_id'] : '',
        'date' => !empty($data['field_date']) ? $data['field_date'][0]['value'] : '',
        'weight' => !empty($data['field_weight']) ? $data['field_weight'][0]['value'] : '',
        'blood_pressure' => !empty($data['field_blood_pressure']) ? $data['field_blood_pressure'][0]['value'] : '',
        'treatment_type_' => !empty($data['field_treatment_protocol']) ? $treatment_tids : '',
        'subcutaneous_fat' => !empty($data['field_subcutaneous_fat']) ? $subcutaneous_tids : '',
        'skin_tightening' => !empty($data['field_skin_tightening']) ? $skin_tids : '',
        'cellulite' => !empty($data['field_cellulite']) ? $cellulite_tids : '',
        'notes' => !empty($data['field_notes']) ? $data['field_notes'][0]['value'] : '',
        'before_and_after_photos' => !empty($data['field_before_and_after_photos']) ? $field_before_and_after_photos : '',
        'show_all_measurements' => !empty($data['field_all_measurements']) ? $data['field_all_measurements'][0]['value'] : '',
        'neck' => !empty($data['field_neck']) ? $data['field_neck'][0]['value'] : '',
        'arm_left_bicep' => !empty($data['field_arm_left_bicep']) ? $data['field_arm_left_bicep'][0]['value'] : '',
        'arm_right_bicep' => !empty($data['field_arm_right_bicep']) ? $data['field_arm_right_bicep'][0]['value'] : '',
        'back_bra_line' => !empty($data['field_back_bra_line']) ? $data['field_back_bra_line'][0]['value'] : '',
        'abdomen' => !empty($data['field_abdomen']) ? $data['field_abdomen'][0]['value'] : '',
        'hips' => !empty($data['field_hips']) ? $data['field_hips'][0]['value'] : '',
        'buttocks' => !empty($data['field_buttocks']) ? $data['field_buttocks'][0]['value'] : '',
