function patient_photos($row_source){
            $data = $row_source;
            $webform_id = 'patient_photos';
            $webform = Webform::load($webform_id);
             if(!empty($data['field_before_and_after_photos'])){
                   $field_before_and_after_photos = array_column($data['field_before_and_after_photos'], 'fid');
             }else{
                    $field_before_and_after_photos = $data['field_before_and_after_photos'];
             }
            // Create webform submission.
            $values = [
            'webform_id' => $webform->id(),
            'uid'=> $data['uid'],
            'sid' => $data["entityform_id"],
            'data' => [
            'patient' => !empty($data['field_patient']) ? $data['field_patient'][0]['target_id'] : "",
            'profile_photo' => !empty($data['field_profile_photo']) ? $data['field_profile_photo'][0]['fid'] : "",
            'before_and_after_photos' => !empty($field_before_and_after_photos) ? $field_before_and_after_photos : "",
               ],
            ];
        
          \Drupal::logger('chirothintracker')->notice('Data: <pre>' . print_r($values, TRUE) . '</pre>');
            $webform_submission = WebformSubmission::create($values);
            $webform_submission->setCreatedTime($data['created']); 
            $webform_submission->setChangedTime($data['changed']);
            $webform_submission->set('completed', $data['created']); 
            $webform_submission->save();

}


function patient_intake($row_source){
        $data = $row_source;

        $significant_emotional_trauma_ = [];
        $traumas = $data['field_emotional_trauma'] ?? [];
        $ages = $data['field_emotional_trauma_age'] ?? [];
        foreach ($traumas as $index => $trauma_item) {
          $trauma = $trauma_item['value'] ?? '';
          $age = $ages[$index]['value'] ?? '';
          $significant_emotional_trauma_[] = [
            'age' => $age,
            'emotional_trauma' => $trauma,
          ];
        }
        $stressors = $data['field_stressors'] ?? [];
        $data['field_stressors'] = array_map(function ($item) {
             return $item['value'] ?? '';
        }, $stressors);

        $bariatric_surgery = $data['field_history_bariatric_surgery'] ?? [];
        $data['field_history_bariatric_surgery'] = array_map(function ($item) {
          return $item['value'] ?? '';
        }, $bariatric_surgery);

        $food_carving = $data['field_cravings'] ?? [];
        $data['field_cravings'] = array_map(function ($item) {
          return $item['value'] ?? '';
        }, $food_carving);

        $history_eating_disorder = $data['field_history_eating_disorder'] ?? [];
        $data['field_history_eating_disorder'] = array_map(function ($item) {
          return $item['value'] ?? '';
        }, $history_eating_disorder);

        $medical_symptoms = $data['field_medical_symptoms'] ?? [];
        $data['field_medical_symptoms'] = array_map(function ($item) {
          return $item['value'] ?? '';
        }, $medical_symptoms);

        $medications = $data['field_medications'] ?? [];
        $data['field_medications'] = array_map(function ($item) {
          return $item['value'] ?? '';
        }, $medications);

        $programs = $data['field_programs'] ?? [];
        $data['field_programs'] = array_map(function ($item) {
          return $item['value'] ?? '';
        }, $programs);

        $blood_pressure_medications = $data['field_blood_pressure_medications'] ?? [];
        $data['field_blood_pressure_medications'] = array_map(function ($item) {
          return $item['value'] ?? '';
        }, $blood_pressure_medications);
 
        $thyraid_medications = $data['field_thyroid_medications'] ?? [];
        $data['field_thyroid_medications'] = array_map(function ($item) {
        return $item['value'] ?? '';
        }, $thyraid_medications);

        $cholesterol_medications = $data['field_cholesterol_medications'] ?? [];
        $data['field_cholesterol_medications'] = array_map(function ($item) {
          return $item['value'] ?? '';
        }, $cholesterol_medications);   

        $other_symptoms = $data['field_other_symptoms'] ?? [];
        $data['field_other_symptoms'] = array_map(function ($item) {
          return $item['value'] ?? '';
        }, $other_symptoms);     



                if(!empty($data['field_mailing_address'])){
                            $mailing_address_ = array(
                                "additional_name" => '',
                                "address_line1" => $data['field_mailing_address'][0]['thoroughfare'],
                                "address_line2" => $data['field_mailing_address'][0]['premise'],
                                "address_line3" => '',
                                "administrative_area" => $data['field_mailing_address'][0]['administrative_area'],
                                "country_code" => $data['field_mailing_address'][0]['country'],
                                "dependent_locality" => '',
                                "family_name" => '',
                                "given_name" => '',
                                "langcode" => '',
                                "locality" => $data['field_mailing_address'][0]['locality'],
                                "organization" => $data['field_mailing_address'][0]['organisation_name'],
                                "postal_code" => $data['field_mailing_address'][0]['postal_code'],
                                "sorting_code" => ''
                        );
                }
        $webform_id = 'patient_intake';
        $webform = Webform::load($webform_id);
        $clinic_id = getClinicFromDomain($data["field_domain"][0]["value"]);

       // \Drupal::logger('chirothintracker')->notice('Domain: <pre>' . print_r($data["field_domain"], TRUE) . '</pre>');
 
        // Create webform submission.
        $values = [
        'webform_id' => $webform->id(),
        'uid'=> $data['uid'],
        'sid' => $data["entityform_id"],
        'data' => [
        'first_name' => $data["field_first_name"][0]["value"],
        'last_name' => $data["field_last_name"][0]["value"],
        'email_address' => $data["field_email_address"][0]["email"],
        'phone_number' => $data["field_phone_number"][0]["value"],
        'mailing_address_' => $mailing_address_,
        'field_gender' => $data["field_gender"][0]["value"],
        'date_of_birth' => !empty($data['field_date_of_birth'][0]['value']) ? $data['field_date_of_birth'][0]['value'] : '',
        'occupation' => !empty($data['field_occupation'][0]['value']) ? $data['field_occupation'][0]['value'] : '',
        'marital_status' => !empty($data['field_marital_status'][0]['value']) ? $data['field_marital_status'][0]['value'] : '',
        'number_of_children' => !empty($data['field_number_of_children'][0]['value']) ? $data['field_number_of_children'][0]['value'] : '',
        'emergency_contact_name' => !empty($data['field_emergency_contact_name'][0]['value']) ? $data['field_emergency_contact_name'][0]['value'] : '',
        'emergency_contact_phone' => !empty($data['field_emergency_contact_phone'][0]['value']) ? $data['field_emergency_contact_phone'][0]['value'] : '',
        'what_is_your_motivation_for_losing_weight_' => !empty($data['field_motivation'][0]['value']) ? $data['field_motivation'][0]['value'] : '',
        'field_programs' =>  !empty($data['field_programs']) ? $data['field_programs'] : '',
        'field_program_start_date' => !empty($data['field_program_start_date'][0]['value']) ? $data['field_program_start_date'][0]['value'] : '',
        'daily_activity_level' => $data["field_daily_activity_level"][0]["value"],
        'current_weight_lbs_' =>  $data["field_weight"][0]["value"],
        'desired_weight_lbs_' =>  !empty($data['field_goal_weight'][0]['value']) ? $data['field_goal_weight'][0]['value'] : '',
        'height_inches_' => !empty($data['field_height'][0]['value']) ? $data['field_height'][0]['value'] : '',
        'field_medical_eligibility' => $data["field_medical_eligibility"][0]["value"],
        'field_medical_eligibility_choice' => !empty($data['field_medical_eligibility_choice'][0]['value']) ? $data['field_medical_eligibility_choice'][0]['value'] : '',
        'field_history_eating_disorder' => !empty($data['field_history_eating_disorder']) ? $data['field_history_eating_disorder'] : '',
        'field_history_bariatric_surgery' => !empty($data['field_history_bariatric_surgery']) ? $data['field_history_bariatric_surgery'] : '',
        'field_surgery_weight_loss' => !empty($data['field_surgery_weight_loss'][0]['value']) ? $data['field_surgery_weight_loss'][0]['value'] : '',
        'field_surgery_weight_gain' => !empty($data['field_surgery_weight_gain'][0]['value']) ? $data['field_surgery_weight_gain'][0]['value'] : '',
        'field_gall_bladder' => $data["field_gall_bladder"][0]["value"],
        'field_diabetes' => $data["field_diabetes"][0]["value"],
        'year_diagnosed' => !empty($data['field_diabetes_diagnosis_year'][0]['value']) ? $data['field_diabetes_diagnosis_year'][0]['value'] : '',
        'diabetes_medications' =>  !empty($data['field_diabetes_medications'][0]['value']) ? $data['field_diabetes_medications'][0]['value'] : '',
        'field_high_blood_pressure' => $data["field_high_blood_pressure"][0]["value"],
        'field_bp_diagnosis_year' =>!empty($data['field_bp_diagnosis_year'][0]['value']) ? $data['field_bp_diagnosis_year'][0]['value'] : '',
        'field_thyroid_condition' =>  $data["field_thyroid_condition"][0]["value"],
        'field_thyroid_diagnosis_year' => !empty($data['field_thyroid_diagnosis_year'][0]['value']) ? $data['field_thyroid_diagnosis_year'][0]['value'] : '',
        'field_blood_pressure_medications' => !empty($data['field_blood_pressure_medications']) ? $data['field_blood_pressure_medications'] : '',
        'field_thyroid_medications' => !empty($data['field_thyroid_medications']) ? $data['field_thyroid_medications'] : '',
        'field_high_cholesterol' =>  $data["field_high_cholesterol"][0]["value"],
        'field_cholesterol_diagnosis_year' => !empty($data['field_cholesterol_diagnosis_year'][0]['value']) ? $data['field_cholesterol_diagnosis_year'][0]['value'] : '',
        'field_cholesterol_medications' => !empty($data['field_cholesterol_medications']) ? $data['field_cholesterol_medications'] : '',
        'field_medical_symptoms' => !empty($data['field_medical_symptoms']) ? $data['field_medical_symptoms'] : '',
        'field_other_symptoms' => !empty($data['field_other_symptoms']) ? $data['field_other_symptoms'] : '',
        'field_medications' => !empty($data['field_medications']) ? $data['field_medications'] : '',
        'field_health_challenge' => !empty($data['field_health_challenge'][0]['value']) ? $data['field_health_challenge'][0]['value'] : '',
        'field_emotional_eater' => $data["field_emotional_eater"][0]["value"],
        'field_cravings' => !empty($data['field_cravings']) ? $data['field_cravings'] : '',
        'field_stressors' => !empty($data['field_stressors']) ? $data['field_stressors'] : '',
        'significant_emotional_trauma_' => $significant_emotional_trauma_,
        'field_agreement' => $data["field_agreement"][0]["value"],
        'field_program_agreement' => $data["field_program_agreement"][0]["value"],
        //'field_media_release_agreement' => $data["field_media_release_agreement"][0]["value"],
        'field_consent_consumption' => $data["field_consent_consumption"][0]["value"],
        'media_consent' => !empty($data['field_media_release_disagree'][0]['value']) ? $data['field_media_release_disagree'][0]['value'] : '',
        'field_consent' => $data["field_consent"][0]["value"],
        'clinic' => !empty($clinic_id) ? $clinic_id : array(),
        ],
        ];
        $webform_submission = WebformSubmission::create($values);
        $webform_submission->setCreatedTime($data['created']); 
        $webform_submission->setChangedTime($data['changed']);
        $webform_submission->set('completed', $data['created']); 
        $webform_submission->save();
