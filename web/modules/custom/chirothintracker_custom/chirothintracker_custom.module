function message($row_source){
            $data = $row_source;
            $field_message = $data["field_message"][0]["value"];
            $message_id = 'message';
            $message_webform = Webform::load($message_id);
            $message_value = [
                'value' => $field_message,
                'format' => $data["field_message"][0]['format'] ?? 'filtered_html'
            ];
            // Create webform submission.
            $values = [
            'webform_id' => $message_webform->id(),
            'uid'=> $data['uid'],
            //'sid' => $data["entityform_id"],
            'data' => [
            'field_from' => $data["field_from"][0]['target_id'],
            'field_to' => $data["field_to"][0]['target_id'],
            'field_message' => $message_value,
            'attachments' => "",
            'field_patient_uid' => $data["field_patient_uid"][0]['value'],
            'field_timestamp' => $data["field_timestamp"][0]['value'],
               ],
            ];
            $message_webform_submission = WebformSubmission::create($values);
            $message_webform_submission->setCreatedTime($data['created']); 
            $message_webform_submission->setChangedTime($data['changed']);
            $message_webform_submission->set('completed', $data['created']); 
            $message_webform_submission->save();

}

function log_your_progress($row_source){
            $data = $row_source;
            $webform_id = 'tracking_weight';
            $webform = Webform::load($webform_id);


              if(!empty($data["field_flags"])){
                    $flags_tids = array_column($data['field_flags'], 'tid');
                 }
               if(!empty($data["field_chiropractor_flags"])){
                    $chiropractor_flags_tids = array_column($data['field_chiropractor_flags'], 'tid');
                 }   
                  if(!empty($data["field_lunch_vegetables"])){
                    $lunch_vegetables_tids = array_column($data['field_lunch_vegetables'], 'tid');
                 }   
                   if(!empty($data["field_dinner_vegetables_free"])){
                    $dinner_vegetables_free_tids = array_column($data['field_dinner_vegetables_free'], 'tid');
                 }
                     if(!empty($data["field_lunch_vegetables_free"])){
                    $lunch_vegetables_free_tids = array_column($data['field_lunch_vegetables_free'], 'tid');
                 }  

                  if(!empty($data["field_dinner_vegetables"])){
                    $dinner_vegetables_tids = array_column($data['field_dinner_vegetables'], 'tid');
                 } 

                $field_lunch_other = $data['field_lunch_other'] ?? [];
                $data['field_lunch_other'] = array_map(function ($item) {
                return $item['value'] ?? '';
                }, $field_lunch_other);

                $field_dinner_other = $data['field_dinner_other'] ?? [];
                $data['field_dinner_other'] = array_map(function ($item) {
