# Origin the Next.js app is served from. Used as `metadataBase` so absolute
# URLs (canonical, Open Graph, sitemap entries) resolve against this host rather
# than against the legacy chirothintracker.com domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Drupal backend for the Next.js frontend. Lando publishes the appserver on a
# generated host port that is re-allocated on every `lando start`/`restart`, so
# this value goes stale. Symptom of a stale port: every server-side Drupal call
# throws, `/api/auth/me` answers 502, and login "does nothing".
#
# Re-sync after any Lando restart with:
#   wsl -d Ubuntu -e ./frontend/scripts/sync-drupal-port.sh
DRUPAL_INTERNAL_URL=https://127.0.0.1:50720